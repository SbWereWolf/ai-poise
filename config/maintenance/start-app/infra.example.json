        {
          "argv": [
            "${bash}",
            "-o",
            "pipefail",
            "-c",
            "\"$$@\" | \"$$POISE_JQ\" --raw-input --slurp --join-output \"$$POISE_RESULT_FILTER\"",
            "poise-result",
            "${python}",
            "-B",
            "-m",
            "poise_environment.repairs.repository",
            "--repository",
            "${repository}",
            "--base-ref",
            "${base_ref}",
            "--git",
            "${git}",
            "--requirement-id",
            "target-repository",
            "--action",
            "install",
            "--schema",
            "poise/maintenance-action/v2",
            "--recommendations",
            "${profile_root}/recommendations.json"
          ],
          "cwd": "${profile_root}",
          "env": {
            "PYTHONPATH": "${runtime_module_path}",
            "PYTHONDONTWRITEBYTECODE": "1",
            "LANG": "C.UTF-8",
