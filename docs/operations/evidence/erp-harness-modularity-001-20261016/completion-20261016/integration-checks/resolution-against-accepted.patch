+            finally:
+                self.wait_workers(server)
+
+    def call(self, server, arguments: dict, request_id: int = 2) -> None:
+        message = json.loads(self.messages.read_text())[2]
+        message["id"] = request_id
+        message["params"]["arguments"] = arguments
+        server.handle(message)
+        self.wait_workers(server)
+
+    def response_for(self, responses: list[dict], request_id: int) -> dict:
+        matching = [message for message in responses if message.get("id") == request_id]
+        self.assertEqual(len(matching), 1)
+        return matching[0]
