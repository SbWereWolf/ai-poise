{
  "schema": "poise-source-index-policy-1",
  "enabled": true,
  "command_argv": [],
  "query_commands": ["search", "usages"],
  "paths": {
    "database": ".runtime/ast-index/index.db",
    "lock": ".runtime/ast-index/poise.lock",
    "runs": ".runtime/ast-index/runs"
  },
  "limits": {
    "lock_seconds": 5.0,
    "lock_poll_seconds": 0.01,
    "run_seconds": 15.0,
    "cleanup_seconds": 2.0
  }
}
