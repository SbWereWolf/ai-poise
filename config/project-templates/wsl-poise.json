{
  "schema": "project-blueprint-1",
  "version": "8",
  "config": {
    "schema": "ddd-accounting-12",
    "project": "REPLACE_WITH_PROJECT_ID",
    "paths": {
      "state": "",
      "database": "tasks.sqlite",
      "lock": "tasks.lock",
      "runtime": "runtime",
      "standalone_tasks": "artifacts/standalone",
      "sprints": "artifacts/sprints",
      "worktrees": "worktrees",
      "git_index": "snapshot.index",
      "runs": "runs",
      "stdout": "stdout.txt",
      "stderr": "stderr.txt",
      "response": "response.json",
      "requirements_database": "database/requirements.sqlite",
      "requirements_lock": "database/requirements.lock"
    },
    "limits": {
      "lock_seconds": 2.0,
      "lock_poll_seconds": 0.01,
      "git_seconds": 15.0,
      "verify_attempts": 5,
      "output_chars": 2200,
      "preview_chars": 300
    },
    "git": {
      "repository": "REPLACE_WITH_ABSOLUTE_APPLICATION_REPOSITORY",
      "base_ref": "main",
      "remote": "REPLACE_WITH_CONFIGURED_REMOTE_NAME",
      "branch_template": "tasks/{task_id}",
      "commit_pattern": "(?s).+",
      "author_name": "REPLACE_WITH_COMMIT_AUTHOR_NAME",
      "author_email": "REPLACE_WITH_COMMIT_AUTHOR_EMAIL",
      "push_required": true
    },
    "processes": {
      "analysis": "config/processes/analysis.json",
      "design": "config/processes/design.json",
      "development": "config/processes/development.json",
      "documentation": "config/processes/documentation.json",
      "environment_diagnostics": "config/processes/environment_diagnostics.json",
      "environment_remediation": "config/processes/environment_remediation.json",
      "integration": "config/processes/integration.json",
      "profiling": "config/processes/profiling.json",
      "review": "config/processes/review.json",
      "sprint_planning": "config/processes/sprint_planning.json",
      "task_planning": "config/processes/task_planning.json",
      "test_development": "config/processes/test_development.json",
      "verification": "config/processes/verification.json"
    },
    "environment_names": [
      "PATH",
      "HOME"
    ],
    "automatic_checks": [],
    "task_decomposition": {
      "skills": [
        {
          "id": "workflow",
          "class": "meta",
          "responsibility": null
        },
        {
          "id": "general",
          "class": "general",
          "responsibility": null
        },
        {
          "id": "backend",
          "class": "narrow",
          "responsibility": "backend"
        },
        {
          "id": "frontend",
          "class": "narrow",
          "responsibility": "frontend"
        }
      ],
      "areas": [
        {
          "path": "src/**",
          "responsibility": "application"
        },
        {
          "path": "tests/**",
          "responsibility": "application"
        },
        {
          "path": "docs/**",
          "responsibility": "documentation"
        }
      ]
    },
    "batch": {
      "max_input_bytes": 1048576,
      "max_items": 1000,
      "max_artifact_bytes": 262144,
      "file_mode": 384,
      "artifact_lock": "artifact.lock",
      "artifact_directories": {
        "runtime": "generated",
        "task": "artifacts",
        "sprint": "artifacts"
      },
      "templates": {
        "note": {
          "version": "1",
          "text": "# ${title}\n\n${body}\n",
          "parameters": [
            "title",
            "body"
          ]
        }
      },
      "message_source": {
        "id": "chat-visible",
        "mode": "agent_reported"
      },
      "message_reasons": [
        "initial",
        "continue",
        "feedback",
        "requirement_change",
        "clarification",
        "authorization",
        "cancel"
      ],
      "initial_read_lines": 50
    },
    "sprint": {
      "max_tasks": 1000,
      "max_dependencies": 3000,
      "acceptable_terminal_states": [
        "completed",
        "cancelled"
      ],
      "templates": {
        "basic": {
          "version": "1",
          "goal": "",
          "requirements": [],
          "definition_of_done": [],
          "sections": {
            "plan": "Заполнить план."
          },
          "tasks": [],
          "dependencies": []
        }
      },
      "section_rules": [
        {
          "name": "plan",
          "template": "Заполнить план.",
          "normalization": "strip",
          "required": true
        }
      ]
    },
    "runtime_services": {
      "check_runner": {
        "initial_seconds": 120,
        "history_multiplier": 1.1,
        "progress_gap_seconds": 120,
        "poll_seconds": 0.1,
        "diagnostic_override_max_seconds": 900
      },
      "output": {
        "known": [
          {
            "id": "unittest",
            "argv_tokens": [
              "-m",
              "unittest"
            ],
            "parser": "lines",
            "selection_pattern": "^(Ran [0-9]+ test|OK|FAILED|FAIL:|ERROR:).*",
            "primary_chars": 512,
            "extended_bytes": 4096,
            "selected_bytes": 4096,
            "files": {
              "extended": "extended.txt",
              "full": "full.txt",
              "selected": "selected.txt"
            }
          }
        ],
        "unknown": {
          "id": "unknown",
          "argv_tokens": [],
          "parser": "tail",
          "selection_pattern": null,
          "primary_chars": 512,
          "extended_bytes": 4096,
          "selected_bytes": 4096,
          "files": {
            "extended": "extended.txt",
            "full": "full.txt",
            "selected": null
          }
        },
        "directory": "views",
        "manifest": "views.json",
        "job": "job.json",
        "worker_stdout": "worker-out.txt",
        "worker_stderr": "worker-err.txt",
        "chunk_bytes": 65536,
        "worker_timeout_seconds": 15,
        "file_mode": 384
      },
      "handoff": {
        "directory": ".runtime/poise/handoffs",
        "receipt": "handoff.json",
        "bundle": "source.bundle",
        "preserved_directory": "preserved",
        "file_mode": 384
      },
      "transfer": {
        "directory": "transfers",
        "archive": "work.tar.gz",
        "manifest": "manifest.json",
        "database": "snapshot.sqlite",
        "files_directory": "files",
        "max_tasks": 1000,
        "max_files": 10000,
        "max_file_bytes": 33554432,
        "max_total_bytes": 134217728,
        "chunk_bytes": 65536,
        "file_mode": 384,
        "recovery": {
          "format": "poise-recovery-1",
          "tool_argv": [
            "/example/bin/node",
            "/example/workspace-recover/bin/workspace-recover.mjs"
          ],
          "mapping": {
            "version": "task-materials-1",
            "materials": []
          },
          "systems": {
            "poise": {
              "repository": "/example/poise",
              "configs": [
                "/example/poise/project.json"
              ]
            },
            "project": {
              "repository": "/example/project",
              "configs": [
                "/example/project/project.json"
              ]
            }
          },
          "repositories": {
            "task": "/example/project"
          },
          "paths": {
            "staging": "prepared",
            "create_session": "create-session",
            "restore_session": "restore-session"
          },
          "placement_decisions": [],
          "create_flow": {
            "schema": "workspace-recover/flow/v3",
            "workspace": "${variables.workspace}",
            "steps": [
              {
                "id": "archive",
                "op": "archive",
                "from": "${variables.staging}",
                "to": "${variables.package}",
                "onError": "stop"
              }
            ]
          },
          "restore_flow": {
            "schema": "workspace-recover/flow/v3",
            "workspace": "${variables.workspace}",
            "steps": [
              {
                "id": "extract",
                "op": "extract",
                "from": "${variables.package}",
                "to": "${variables.staging}",
                "existingTarget": "merge",
                "onError": "stop"
              },
              {
                "id": "place",
                "op": "command",
                "argv": "${variables.place_argv}",
                "onError": "stop"
              },
              {
                "id": "components",
                "op": "command",
                "argv": "${variables.components_argv}",
                "onError": "stop"
              },
              {
                "id": "validate",
                "op": "verification",
                "argv": "${variables.validate_argv}",
                "onError": "stop"
              }
            ]
          },
          "component_steps": []
        }
      }
    },
    "accounting": {
      "timezone": "UTC",
      "week_start": 0,
      "storage": {
        "database": "telemetry/events.sqlite",
        "lock": "telemetry/events.lock"
      },
      "max_events": 1000,
      "max_files": 1000,
      "max_blob_bytes": 1048576,
      "time_mode": "tool_cycle",
      "causes": [
        "initial",
        "internal_qa",
        "delivered_rework",
        "requirement_change",
        "poise_incident"
      ],
      "sources": {
        "test": "reported",
        "codex": "observed"
      },
      "path_categories": {
        "code": [
          "src/**"
        ],
        "tests": [
          "tests/**"
        ],
        "fixtures": [
          "fixtures/**"
        ],
        "documentation": [
          "docs/**",
          "*.md",
          ".agents/**",
          "skills/**",
          "ai-assistant/**"
        ]
      },
      "tokenizer": {
        "kind": "unavailable",
        "identity": "not-configured",
        "command": null
      }
    }
  },
  "questions": [
    {
      "id": "project",
      "path": [
        "project"
      ],
      "type": "text",
      "prompt": "Project identifier"
    },
    {
      "id": "repository",
      "path": [
        "git",
        "repository"
      ],
      "type": "text",
      "prompt": "Absolute Git repository root"
    },
    {
      "id": "base",
      "path": [
        "git",
        "base_ref"
      ],
      "type": "text",
      "prompt": "Exact base ref to resolve locally"
    },
    {
      "id": "remote",
      "path": [
        "git",
        "remote"
      ],
      "type": "text",
      "prompt": "Git remote name (still explicit when push is disabled)"
    },
    {
      "id": "author_name",
      "path": [
        "git",
        "author_name"
      ],
      "type": "text",
      "prompt": "Commit author name"
    },
    {
      "id": "author_email",
      "path": [
        "git",
        "author_email"
      ],
      "type": "text",
      "prompt": "Commit author email"
    },
    {
      "id": "push",
      "path": [
        "git",
        "push_required"
      ],
      "type": "boolean",
      "prompt": "Require push of verified task branch"
    },
    {
      "id": "state",
      "path": [
        "paths",
        "state"
      ],
      "type": "text",
      "prompt": "Absolute AI poise project-data root (outside the serviced code repository)"
    },
    {
      "id": "environment",
      "path": [
        "environment_names"
      ],
      "type": "strings",
      "prompt": "Names of inherited environment variables"
    }
  ],
  "process_sources": {
