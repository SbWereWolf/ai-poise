+    @contextlib.contextmanager
+    def catalogue_loading_fault(self, case: dict, catalogue: Path):
+        profile = catalogue / "ai-assistant/checks/command-profiles.toml"
+        original = profile.read_bytes()
+        kind = case["id"]
+        try:
+            if kind == "unreadable":
+                injected = PermissionError(case["errno"], "Fixture selected catalogue read denied", str(profile))
+                original_open = Path.open
+                def fail_selected_read(path, *args, **kwargs):
+                    if path == profile:
+                        raise injected
+                    return original_open(path, *args, **kwargs)
+                with patch.object(Path, "open", fail_selected_read):
+                    yield injected
+                self.assertEqual(profile.read_bytes(), original)
+            else:
+                if kind == "missing":
+                    profile.unlink()
+                elif kind in {"invalid_toml", "unsupported_version"}:
+                    profile.write_bytes(case["payload_text"].encode("utf-8"))
+                elif kind == "invalid_utf8":
+                    profile.write_bytes(bytes.fromhex(case["payload_hex"]))
+                else:
+                    raise AssertionError("Unknown catalogue-loading fixture kind")
+                yield None
+                if kind == "missing":
+                    self.assertFalse(profile.exists())
+                else:
+                    expected = bytes.fromhex(case["payload_hex"]) if kind == "invalid_utf8" else case["payload_text"].encode("utf-8")
+                    self.assertEqual(profile.read_bytes(), expected)
+        finally:
+            profile.write_bytes(original)
+            self.assertEqual(profile.read_bytes(), original)
+
+    def assert_loading_diagnostic(self, message: str, case: dict, catalogue: Path) -> None:
