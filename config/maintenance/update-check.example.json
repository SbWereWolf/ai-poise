{
  "requirements": [
    {
      "id": "registered-consumer-update",
      "commands": [
        {
          "argv": [
            "${python}",
            "-B",
            "-m",
            "poise_environment.consumer_updates",
            "--config",
            "${consumer_config}"
          ],
          "cwd": ".",
          "env": {
            "PYTHONPATH": "${runtime_module_path}",
            "LANG": "C.UTF-8"
          },
          "interpreter": {
            "name": "exit",
            "options": {
              "accept": [
                0
              ]
            }
          }
        }
      ]
    }
  ]
}
