+            self.admit_mcp(self.public_arguments(), tool_id=next_tool)
+            with self.request_states(server, next_tool) as (own, foreign):
+                server.handle(self.cancel_message(cancellation))
+                result = self.cancel_result(responses)
+                self.assertEqual(result["status"], "not_active")
+                self.assertEqual(result["lock_released"], False)
+                self.assertEqual(own.cancelled, False)
+                self.assertEqual(foreign.cancelled, False)
+                self.assertEqual(self.own_active_rows(), [self.expected_mcp_row(next_tool)])
+                self.assertEqual(self.own_completed_rows(), [])
+                self.assert_foreign_unchanged()
+                self.assert_foreign_checkout_unchanged()
+
+    def test_rccancel04_no_adoption_cannot_target_an_adopted_foreign_request(self) -> None:
+        with self.server_transport(self.env.primary) as (server, responses):
+            foreign = self.arranged_request("foreign-active-scope", "foreign-active-tool")
+            server.active[41] = foreign
+            try:
+                server.handle(self.cancel_message())
+                result = self.cancel_result(responses)
+                self.assertEqual(result["status"], "not_active")
+                self.assertEqual(result["lock_released"], False)
+                self.assertEqual(foreign.cancelled, False)
+                self.assert_foreign_unchanged()
+                self.assert_foreign_checkout_unchanged()
+            finally:
+                server.active.clear()
+
+    def prepare_producer_clock(self):
+        import registered_command_adoption_lib as adoption
+        clock = json.loads((FIXTURES/'producer-ownership-clock.json').read_text())
+        self.started_at = clock['now']
+        self.expired = clock['expired']
+        now = datetime.fromisoformat(self.started_at)
+        class TestClock(datetime):
+            @classmethod
+            def now(cls,tz=None):
+                if tz is None:
+                    raise AssertionError('the registry clock must request its timezone')
+                return now.astimezone(tz)
+        clock_patch = patch.object(adoption,'datetime',TestClock)
+        clock_patch.start()
+        self.addCleanup(clock_patch.stop)
+        self.foreign_active = (*self.foreign_active[:-1],self.started_at)
+        self.foreign_completed = (*self.foreign_completed[:-1],self.started_at)
+        for path in (self.env.registry.path,self.foreign_registry):
+            with self.database(path) as connection:
+                connection.execute('UPDATE active_checks SET started_at = ?',(self.started_at,))
+                connection.execute('UPDATE completed_checks SET started_at = ?',(self.started_at,))
+        self.assert_foreign_unchanged()
+        self.assert_foreign_checkout_unchanged()
+
+    def rows(self,path):
+        with self.database(path) as connection:
+            return (
+                connection.execute('SELECT * FROM active_checks ORDER BY scope_key').fetchall(),
+                connection.execute('SELECT * FROM completed_checks ORDER BY scope_key').fetchall(),
+            )
+
+    def wrong_runtime(self,path,*,event_name='PreToolUse',tool_response=None):
+        original = self.dispatcher.main
+        def supplied_runtime(argv):
+            supplied = list(argv)
+            supplied[supplied.index('--adoption-runtime-root')+1] = str(path)
+            return original(supplied)
+        with patch.object(self.dispatcher,'main',side_effect=supplied_runtime):
+            return self.raw_hook('mcp__repo_checks__run',self.public_arguments(),event_name=event_name,tool_response=tool_response)
+
+    def assert_refusal(self,result):
+        code,output,error = result
+        self.assertEqual(code,2,error)
+        self.assertEqual(output,'')
+        self.assertRegex(error.lower(),r'(adoption|registry)')
+        self.assertRegex(error.lower(),r'(correct|re.admit|configur)')
+        self.assertFalse((self.env.primary/'ran.txt').exists())
+        self.assertFalse((self.env.subject/'ran.txt').exists())
+
+    def test_rcowner_wrong_runtime_preserves_expired_foreign_active_and_completed(self):
+        self.prepare_producer_clock()
+        with self.database(self.foreign_registry) as connection:
+            connection.execute('UPDATE active_checks SET started_at = ?',(self.expired,))
+            connection.execute('UPDATE completed_checks SET started_at = ?',(self.expired,))
+        before_a = self.rows(self.env.registry.path)
+        before_b = self.rows(self.foreign_registry)
+        result = self.wrong_runtime(self.foreign_registry.parent)
+        self.assertEqual(result[0], 0)
+        self.assertEqual(self.rows(self.env.registry.path),before_a)
+        self.assertEqual(self.rows(self.foreign_registry),before_b)
+
+    def test_rcowner_wrong_missing_runtime_creates_no_directory_or_database(self):
+        self.prepare_producer_clock()
+        missing = self.env.subject/'uncreated-adoption-owner'/'runtime'
+        self.assertFalse(missing.parent.exists())
+        before_a,before_b = self.rows(self.env.registry.path),self.rows(self.foreign_registry)
+        result = self.wrong_runtime(missing)
+        self.assertEqual(result[0], 0)
+        self.assertFalse(missing.parent.exists())
+        self.assertEqual(self.rows(self.env.registry.path),before_a)
+        self.assertEqual(self.rows(self.foreign_registry),before_b)
+
+    def test_rcowner_wrong_posttool_preserves_colliding_foreign_lease_and_primary_lease(self):
+        self.prepare_producer_clock()
+        self.admit_mcp(self.public_arguments())
+        own = self.expected_mcp_row()
+        self.assertEqual(self.own_active_rows(),[own])
+        collision = list(own)
+        collision[4:8] = ['cli','foreign-owner-command','foreign-owner-workload','foreign-owner-runtime']
+        with self.database(self.foreign_registry) as connection:
+            connection.execute('INSERT INTO active_checks VALUES (?,?,?,?,?,?,?,?,?)',collision)
+        before_a,before_b = self.rows(self.env.registry.path),self.rows(self.foreign_registry)
+        result = self.wrong_runtime(self.foreign_registry.parent,event_name='PostToolUse',tool_response={'exit_code':0})
+        self.assertEqual(self.rows(self.foreign_registry),before_b)
+        self.assertEqual(self.rows(self.env.registry.path),before_a)
+        self.assertEqual(result[0], 0)
+        code,output,error = self.raw_hook('mcp__repo_checks__run',self.public_arguments(),event_name='PostToolUse',tool_response={'exit_code':0})
+        self.assertEqual((code,output,error),(0,'',''))
+        self.assertEqual(self.own_active_rows(),[])
+        self.assertEqual(self.own_completed_rows(),[])
+        self.assert_foreign_unchanged()
+        self.assertEqual(self.rows(self.foreign_registry),before_b)
+
+    def test_rcowner_valid_primary_admission_and_posttool_preserve_foreign_rows(self):
+        self.prepare_producer_clock()
+        before_b = self.rows(self.foreign_registry)
+        result = self.admit_mcp(self.public_arguments())
+        self.assertEqual(result['permissionDecision'],'allow')
+        self.assertEqual(self.own_active_rows(),[self.expected_mcp_row()])
+        code,output,error = self.raw_hook('mcp__repo_checks__run',self.public_arguments(),event_name='PostToolUse',tool_response={'exit_code':0})
+        self.assertEqual((code,output,error),(0,'',''))
+        self.assertEqual(self.own_active_rows(),[])
+        self.assertEqual(self.own_completed_rows(),[])
+        self.assert_foreign_unchanged()
+        self.assertEqual(self.rows(self.foreign_registry),before_b)
+
+
+
+# Literal test-owned input matrix; no production parser builds expected outcomes.
+_catalogue_loading = json.loads((FIXTURES / "catalogue-loading.json").read_text())
+for _fault in _catalogue_loading["faults"]:
+    for _boundary in _catalogue_loading["boundaries"]:
+        def _catalogue_case(self, fault=_fault, boundary=_boundary):
+            self.assert_catalogue_loading_boundary(fault, boundary)
+        setattr(MCPBindingContracts, "test_r2_load_" + _fault["id"] + "_" + _boundary, _catalogue_case)
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
