    "python": "python3",
    "module_path": "",
    "profile_root": "",
    "state_root": "",
    "repository": "",
    "project_id": "",
    "base_ref": "main",
    "author_name": "",
    "author_email": "",
    "git": "git",
    "directory_mode": "0750",
    "python_minimum": "3.15",
    "python_maximum": "3.16",
    "template_id": "linux-reference",
    "remote": "disabled",
    "env_executable": "env",
    "wheelhouse": "/srv/poise/wheels",
    "dependency_target": "/srv/poise/.runtime/dependencies",
    "task_database_lock_executable": "/usr/bin/flock",
    "task_database_lock_wait_seconds": "2.0",
    "task_database_lock_relative": "state.lock"
  },
  "derived_parameters": {
    "dependency_target": "${repository}/.runtime/dependencies",
    "runtime_module_path": "${repository}/src${path_separator}${dependency_target}${path_separator}${repository}",
    "worktree_root": "${repository}/.runtime/worktrees",
    "task_database_lock": "${state_root}/${task_database_lock_relative}"
  },
