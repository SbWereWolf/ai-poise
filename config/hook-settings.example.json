{
  "schema": "hook-settings-1",
  "root": "${FILESYSTEM_ROOT}",
  "project_config": "poise-op/app/projects/poise-op/config/project.json",
  "python": "${PYTHON_EXECUTABLE}",
  "source_root": "${PYTHON_PACKAGE_ROOT}",
  "hooks_file": "poise-op/app/.codex/hooks.json",
  "definitions": "poise-op/app/projects/poise-op/config/hook-definitions",
  "state": "poise-project-data/poise-op/codex-hook",
  "lock": "poise-project-data/poise-op/codex-hook/sessions-runtime.lock",
  "database": "sessions-runtime.sqlite",
  "bindings": "bindings",
  "launcher": "work.sh",
  "binding_file": "binding.json",
  "observations": "probes",
  "response_file": "response.json",
  "project_launcher": {
    "settings_path": "${LAUNCHER_SETTINGS_PATH}",
    "context_template": "Use {launcher} --project EXACT_ID for an explicitly selected project. Follow that project's message contract. Without a selector use the bound project."
  },
  "capability_summary": {
    "file": "capabilities.json",
    "header_template": "Infrastructure ready={ready}; checked_at={checked_at}; workspace={workspace}; snapshot={snapshot_path}",
    "item_template": "{id}: {status}; required={required}; reason={reason}; remediation={remediation}"
  },
  "cwd_roots": [
    "${REPOSITORY_ROOT}"
  ],
  "file_mode": 384,
  "executable_mode": 448,
  "lock_seconds": 3.0,
  "lock_poll_seconds": 0.01,
  "max_input_bytes": 1048576,
  "output_chars": 5000,
  "max_probes": 30,
  "probe_files": {
    "stdout": "stdout.txt",
    "stderr": "stderr.txt",
    "receipt": "receipt.json"
  },
  "exit_codes": {
    "success": 0,
    "incomplete": 1,
    "rejected": 2
  }
}
