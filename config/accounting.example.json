{
  "causes": [
    "initial",
    "internal_qa",
    "delivered_rework",
    "requirement_change",
    "poise_incident"
  ],
  "max_blob_bytes": 1048576,
  "max_events": 1000,
  "max_files": 1000,
  "path_categories": {
    "code": [
      "src/**"
    ],
    "documentation": [
      "docs/**",
      "*.md"
    ],
    "fixtures": [
      "fixtures/**"
    ],
    "tests": [
      "tests/**"
    ]
  },
  "sources": {
    "codex": "observed",
    "test": "reported"
  },
  "storage": {
    "database": "telemetry/events.sqlite",
    "lock": "telemetry/events.lock"
  },
  "time_mode": "tool_cycle",
  "timezone": "UTC",
  "tokenizer": {
    "command": null,
    "identity": "not-configured",
    "kind": "unavailable"
  },
  "week_start": 0
}
