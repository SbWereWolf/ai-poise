BASH_RUNTIME_PHP_BIN=${php_executable}
BASH_RUNTIME_PYTHON_BIN=/usr/bin/python3
REPOSITORY_HOST_PYTHON_BIN=${python}
BASH_RUNTIME_DOCKER_BIN=/usr/bin/docker
APPLICATION_COMPOSER_PROCESS_TIMEOUT_SECONDS=600
ISOLATED_REDIS_CLEANUP_RETRY_ATTEMPTS=3
ISOLATED_REDIS_CLEANUP_RETRY_DELAY_SECONDS=1
ISOLATED_REDIS_RESOURCE_LABEL=erp.environment-maintenance
ISOLATED_REDIS_STALE_AFTER_SECONDS=3600
BASH_RUNTIME_SHELLCHECK_BIN=/usr/bin/shellcheck
BASH_RUNTIME_SHFMT_BIN=/usr/bin/shfmt
