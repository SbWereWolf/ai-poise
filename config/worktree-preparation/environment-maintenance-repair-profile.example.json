{
  "preserve_paths": [],
  "asset_directories": [],
  "text_documents": [],
  "documents": [
    {
      "source": "consumer-app.json",
      "destination": "app.json",
      "edits": []
    },
    {
      "source": "consumer-infra.json",
      "destination": "infra.json",
      "edits": []
    },
    {
      "source": "consumer-parameters.json",
      "destination": "parameters.json",
      "edits": [
        {
          "path": [
            "repository"
          ],
          "value": "${repository}"
        },
        {
          "path": [
            "profile_root"
          ],
          "value": "${profile_root}"
        },
        {
          "path": [
            "task_root"
          ],
          "value": "${task_root}"
        },
        {
          "path": [
            "path"
          ],
          "value": "${path}"
        },
        {
          "path": [
            "module_path"
          ],
          "value": "${module_path}"
        },
        {
          "path": [
            "node"
          ],
          "value": "${node}"
        },
        {
          "path": [
            "npm_entry_point"
          ],
          "value": "${npm_entry_point}"
        },
        {
          "path": [
            "bootstrap_python"
          ],
          "value": "${bootstrap_python}"
        }
      ]
    },
    {
      "source": "environment-maintenance-repair-deps.json",
      "destination": "deps.json",
      "edits": []
    },
    {
      "source": "environment-maintenance-repair-check.json",
      "destination": "check.json",
      "edits": []
    },
    {
      "source": "environment-maintenance-repair-run.json",
      "destination": "run.json",
      "edits": []
    }
  ]
}
