{
  "accounting": {
    "causes": [
      "initial",
      "internal_qa",
      "delivered_rework",
      "requirement_change",
      "poise_incident"
    ],
    "max_blob_bytes": 1048576,
    "max_events": 1000,
    "max_files": 1000,
    "storage": {
      "database": "database/telemetry.sqlite",
      "lock": "database/telemetry.lock"
    },
    "path_categories": {
      "code": [
        "src/**"
      ],
      "documentation": [
        "docs/**",
        "*.md"
      ],
      "fixtures": [
        "fixtures/**"
      ],
      "tests": [
        "tests/**"
      ]
    },
    "sources": {
      "codex": "observed",
      "test": "reported"
    },
    "time_mode": "tool_cycle",
    "timezone": "UTC",
    "tokenizer": {
      "command": null,
      "identity": "not-configured",
      "kind": "unavailable"
    },
    "week_start": 0
  },
  "automatic_checks": [],
  "task_decomposition": {
    "skills": [
      {
        "id": "poise-workflow",
        "class": "meta",
        "responsibility": null
      },
      {
        "id": "poise-development",
        "class": "general",
        "responsibility": null
      },
      {
        "id": "ast-index",
        "class": "general",
        "responsibility": null
      },
      {
        "id": "task-domain",
        "class": "narrow",
        "responsibility": "tasks"
      },
      {
        "id": "sprint-domain",
        "class": "narrow",
        "responsibility": "sprints"
      },
      {
        "id": "verification-domain",
        "class": "narrow",
        "responsibility": "verification"
      },
      {
        "id": "project-config-domain",
        "class": "narrow",
        "responsibility": "project-configuration"
      }
    ],
    "areas": [
      {
        "path": "src/**",
        "responsibility": "ai-poise"
      },
      {
        "path": "tests/**",
        "responsibility": "ai-poise"
      },
      {
        "path": "config/**",
        "responsibility": "project-configuration"
      },
      {
        "path": "docs/**",
        "responsibility": "documentation"
      },
      {
        "path": ".agents/**",
        "responsibility": "agent-instructions"
      },
      {
        "path": "AGENTS.md",
        "responsibility": "agent-instructions"
      }
    ]
  },
  "batch": {
    "artifact_directories": {
      "runtime": "generated",
      "sprint": "artifacts",
      "task": "artifacts"
    },
    "artifact_lock": "artifact.lock",
    "file_mode": 384,
    "initial_read_lines": 50,
    "max_artifact_bytes": 262144,
    "max_input_bytes": 1048576,
    "max_items": 1000,
    "message_reasons": [
      "initial",
      "continue",
      "feedback",
      "requirement_change",
      "clarification",
      "authorization",
      "cancel"
    ],
    "message_source": {
      "id": "codex-hook-main",
      "mode": "runtime_event"
    },
    "templates": {
      "note": {
        "parameters": [
          "title",
          "body"
        ],
        "text": "# ${title}\n\n${body}\n",
        "version": "1"
      }
    }
  },
  "environment_names": [
    "PATH",
    "HOME"
  ],
  "git": {
    "author_email": "you@example.invalid",
    "author_name": "Your Name",
    "base_ref": "YOUR_PRIMARY_CHECKOUT_BRANCH",
    "branch_template": "tasks/{task_id}",
    "commit_pattern": "(?s).+",
    "push_required": false,
    "remote": "origin",
    "repository": "/ABSOLUTE/PATH/TO/AI_POISE"
  },
  "limits": {
    "git_seconds": 15.0,
    "lock_poll_seconds": 0.01,
    "lock_seconds": 2.0,
    "output_chars": 2200,
    "preview_chars": 300,
    "verify_attempts": 5
  },
  "paths": {
    "database": "database/tasks.sqlite",
    "git_index": "snapshot.index",
    "lock": "database/tasks.lock",
    "response": "response.json",
    "runs": "runs",
    "runtime": ".runtime",
    "sprints": "sprint",
    "state": "/ABSOLUTE/PATH/TO/AI_POISE/projects/ai-poise",
    "stderr": "stderr.txt",
    "stdout": "stdout.txt",
    "standalone_tasks": "standalone",
    "worktrees": "worktrees",
    "requirements_database": "/ABSOLUTE/PATH/TO/STATE/requirements.sqlite",
    "requirements_lock": "/ABSOLUTE/PATH/TO/STATE/requirements.lock"
  },
  "processes": {
    "analysis": "config/processes/analysis.json",
    "design": "config/processes/design.json",
    "development": "config/processes/development.json",
    "documentation": "config/processes/documentation.json",
    "environment_diagnostics": "config/processes/environment_diagnostics.json",
    "environment_remediation": "config/processes/environment_remediation.json",
    "integration": "config/processes/integration.json",
    "profiling": "config/processes/profiling.json",
    "review": "config/processes/review.json",
    "sprint_planning": "config/processes/sprint_planning.json",
    "task_planning": "config/processes/task_planning.json",
    "test_development": "config/processes/test_development.json",
    "verification": "config/processes/verification.json"
  },
  "project": "ai-poise",
  "runtime_services": {
    "check_runner": {
      "initial_seconds": 120,
      "history_multiplier": 1.1,
      "progress_gap_seconds": 120,
      "poll_seconds": 0.1,
      "diagnostic_override_max_seconds": 900
    },
    "handoff": {
      "bundle": "source.bundle",
      "directory": "handoffs",
      "file_mode": 384,
      "preserved_directory": "preserved",
      "receipt": "handoff.json"
    },
    "output": {
      "chunk_bytes": 65536,
      "directory": "views",
      "file_mode": 384,
      "job": "job.json",
      "known": [
        {
          "argv_tokens": [
            "-m",
            "unittest"
          ],
          "extended_bytes": 4096,
          "files": {
            "extended": "extended.txt",
            "full": "full.txt",
            "selected": "selected.txt"
          },
          "id": "unittest",
          "parser": "lines",
          "primary_chars": 512,
          "selected_bytes": 4096,
          "selection_pattern": "^(Ran [0-9]+ test|OK|FAILED|FAIL:|ERROR:).*"
        }
      ],
      "manifest": "views.json",
      "unknown": {
        "argv_tokens": [],
        "extended_bytes": 4096,
        "files": {
          "extended": "extended.txt",
          "full": "full.txt",
          "selected": null
        },
        "id": "unknown",
        "parser": "tail",
        "primary_chars": 512,
        "selected_bytes": 4096,
        "selection_pattern": null
      },
      "worker_stderr": "worker-err.txt",
      "worker_stdout": "worker-out.txt",
      "worker_timeout_seconds": 15
    },
    "transfer": {
      "archive": "work.zip",
      "bundles_directory": "bundles",
      "chunk_bytes": 65536,
      "database": "snapshot.sqlite",
      "directory": "transfers",
      "file_mode": 384,
      "files_directory": "files",
      "manifest": "manifest.json",
      "max_file_bytes": 33554432,
      "max_files": 10000,
      "max_tasks": 1000,
      "max_total_bytes": 134217728
    }
  },
  "schema": "ddd-accounting-12",
  "sprint": {
    "acceptable_terminal_states": [
      "completed",
      "cancelled"
    ],
    "max_dependencies": 3000,
    "max_tasks": 1000,
    "section_rules": [
      {
        "name": "plan",
        "normalization": "strip",
        "required": true,
        "template": "Заполнить план."
      }
    ],
    "templates": {
      "basic": {
        "definition_of_done": [],
        "dependencies": [],
        "goal": "",
        "requirements": [],
        "sections": {
          "plan": "Заполнить план."
        },
        "tasks": [],
        "version": "1"
      }
    }
  },
  "task_ids": {
    "namespace": {
      "minimum": 1,
      "maximum": 9999
    },
    "width": 4,
    "progression": {
      "first": 1,
      "step": 1
    }
  }
}
