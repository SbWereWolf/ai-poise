{
  "schema": "environment-maintenance/repairs/v1",
  "repairs": {
    "python-runtime": {
      "argv": [
        "${python}",
        "-B",
        "-m",
        "environment_maintenance.repairs.python_runtime",
        "--minimum",
        "${python_minimum}",
        "--maximum",
        "${python_maximum}"
      ],
      "timeout": 25,
      "env": {
        "PYTHONPATH": "${module_path}",
        "PYTHONDONTWRITEBYTECODE": "1",
        "LANG": "C.UTF-8"
      }
    },
    "target-repository": {
      "argv": [
        "${python}",
        "-B",
        "-m",
        "poise_environment.repairs.repository",
        "--repository",
        "${repository}",
        "--base-ref",
        "${base_ref}",
        "--git",
        "${git}"
      ],
      "timeout": 25,
      "env": {
        "PYTHONPATH": "${module_path}",
        "PYTHONDONTWRITEBYTECODE": "1",
        "LANG": "C.UTF-8"
      }
    },
    "state-root": {
      "argv": [
        "${python}",
        "-B",
        "-m",
        "environment_maintenance.repairs.directory",
        "--path",
        "${state_root}",
        "--permissions",
        "${directory_mode}"
      ],
      "timeout": 25,
      "env": {
        "PYTHONPATH": "${module_path}",
        "PYTHONDONTWRITEBYTECODE": "1",
        "LANG": "C.UTF-8"
      }
    },
    "runtime-directory": {
      "argv": [
        "${python}",
        "-B",
