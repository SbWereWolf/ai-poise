{
  "schema": "poise-tool-result-policy-1",
  "version": "test-1",
  "storage": {
    "root": "@RESULTS@",
    "response": "result.json",
    "stdout": "stdout.bin",
    "stderr": "stderr.bin",
    "text": "text.log",
    "file_mode": 384,
    "chunk_bytes": 4096,
    "retention": "operator-managed"
  },
  "placement": {
    "policy": "@PLACEMENT@",
    "purpose": "tool-result",
    "recipient": "agent",
    "lifetime": "operator-managed"
  },
  "input": {
    "max_bytes": 1048576
  },
  "display": {
    "output_chars": 1800,
    "output_bytes": 2400,
    "passthrough": {
      "max_bytes": 256,
      "max_lines": 8
    },
    "success": {
      "tail_lines": 3,
      "max_excerpt_bytes": 400
    },
    "failure": {
      "match_patterns": [
        "^ERROR:"
      ],
      "match_limit": 2,
      "context_lines": 1,
      "tail_lines": 2,
      "max_excerpt_bytes": 500
    },
    "max_line_bytes": 96,
    "binary": {
      "nul_byte_is_binary": true
    }
  },
  "inspection": {
    "max_lines": 4,
    "max_matches": 2,
    "default_context_lines": 1,
    "max_context_lines": 2,
    "max_excerpt_bytes": 600
  },
  "hook": {
    "mode": "enforce",
    "max_response_bytes": 256,
    "max_response_lines": 8
  }
}
