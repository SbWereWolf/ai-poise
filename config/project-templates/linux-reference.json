{
  "schema": "project-blueprint-1",
  "version": "7",
  "config": {
    "schema": "ddd-accounting-12",
    "project": "REPLACE_WITH_PROJECT_ID",
    "paths": {
      "state": "",
      "database": "tasks/tasks.sqlite",
      "lock": "tasks/tasks.lock",
      "runtime": "runtime",
      "standalone_tasks": "standalone",
      "sprints": "sprints",
      "worktrees": "",
      "git_index": "snapshot.index",
      "runs": "runs",
      "stdout": "stdout.txt",
      "stderr": "stderr.txt",
      "response": "response.json",
      "requirements_database": "requirements/requirements.sqlite",
      "requirements_lock": "requirements/requirements.lock"
    },
    "limits": {
      "lock_seconds": 2.0,
      "lock_poll_seconds": 0.01,
      "git_seconds": 15.0,
      "verify_attempts": 5,
      "output_chars": 2200,
      "preview_chars": 300
    },
    "git": {
      "repository": "REPLACE_WITH_ABSOLUTE_APPLICATION_REPOSITORY",
      "base_ref": "main",
      "remote": "REPLACE_WITH_CONFIGURED_REMOTE_NAME",
      "branch_template": "tasks/{task_id}",
      "commit_pattern": "(?s).+",
      "author_name": "REPLACE_WITH_COMMIT_AUTHOR_NAME",
      "author_email": "REPLACE_WITH_COMMIT_AUTHOR_EMAIL",
      "push_required": true
    },
    "workflows": {
      "analysis": "config/workflows/analysis.json",
      "design": "config/workflows/design.json",
      "development": "config/workflows/development.json",
      "documentation": "config/workflows/documentation.json",
      "environment_diagnostics": "config/workflows/environment_diagnostics.json",
      "environment_remediation": "config/workflows/environment_remediation.json",
      "integration": "config/workflows/integration.json",
      "profiling": "config/workflows/profiling.json",
      "review": "config/workflows/review.json",
      "sprint_planning": "config/workflows/sprint_planning.json",
      "task_planning": "config/workflows/task_planning.json",
      "test_development": "config/workflows/test_development.json",
      "verification": "config/workflows/verification.json"
    },
    "environment_names": [
      "PATH",
      "HOME"
    ],
    "automatic_checks": [],
    "task_decomposition": {
      "skills": [
        {
          "id": "workflow",
          "class": "meta",
          "responsibility": null
        },
        {
          "id": "general",
          "class": "general",
          "responsibility": null
        },
        {
          "id": "backend",
          "class": "narrow",
          "responsibility": "backend"
        },
        {
          "id": "frontend",
          "class": "narrow",
          "responsibility": "frontend"
        }
      ],
      "areas": [
        {
          "path": "src/**",
          "responsibility": "application"
        },
        {
          "path": "tests/**",
          "responsibility": "application"
        },
        {
          "path": "docs/**",
          "responsibility": "documentation"
        }
      ]
    },
    "batch": {
      "max_input_bytes": 1048576,
      "max_items": 1000,
      "max_artifact_bytes": 262144,
      "file_mode": 384,
      "artifact_lock": "artifact.lock",
      "artifact_directories": {
        "runtime": "generated",
        "task": "artifacts",
        "sprint": "artifacts"
      },
      "templates": {
        "note": {
          "version": "1",
          "text": "# ${title}\n\n${body}\n",
          "parameters": [
            "title",
            "body"
          ]
        }
      },
      "message_source": {
        "id": "chat-visible",
        "mode": "agent_reported"
      },
      "message_reasons": [
        "initial",
        "continue",
        "feedback",
        "requirement_change",
        "clarification",
        "authorization",
        "cancel"
      ],
      "initial_read_lines": 50
    },
    "sprint": {
      "max_tasks": 1000,
      "max_dependencies": 3000,
      "acceptable_terminal_states": [
        "completed",
        "cancelled"
      ],
      "templates": {
        "basic": {
          "version": "1",
          "goal": "",
          "requirements": [],
          "definition_of_done": [],
          "sections": {
            "plan": "Заполнить план."
          },
          "tasks": [],
          "dependencies": []
        }
      },
      "section_rules": [
        {
          "name": "plan",
          "template": "Заполнить план.",
          "normalization": "strip",
          "required": true
        }
      ]
    },
    "runtime_services": {
      "check_runner": {
        "initial_seconds": 120,
        "history_multiplier": 1.1,
        "progress_gap_seconds": 120,
        "poll_seconds": 0.1,
        "diagnostic_override_max_seconds": 900
      },
      "output": {
        "known": [
          {
            "id": "unittest",
            "argv_tokens": [
              "-m",
              "unittest"
            ],
            "parser": "lines",
            "selection_pattern": "^(Ran [0-9]+ test|OK|FAILED|FAIL:|ERROR:).*",
            "primary_chars": 512,
            "extended_bytes": 4096,
            "selected_bytes": 4096,
            "files": {
              "extended": "extended.txt",
              "full": "full.txt",
              "selected": "selected.txt"
            }
          }
        ],
        "unknown": {
          "id": "unknown",
          "argv_tokens": [],
          "parser": "tail",
          "selection_pattern": null,
          "primary_chars": 512,
          "extended_bytes": 4096,
          "selected_bytes": 4096,
          "files": {
            "extended": "extended.txt",
            "full": "full.txt",
            "selected": null
          }
        },
        "directory": "views",
        "manifest": "views.json",
        "job": "job.json",
        "worker_stdout": "worker-out.txt",
        "worker_stderr": "worker-err.txt",
        "chunk_bytes": 65536,
        "worker_timeout_seconds": 15,
        "file_mode": 384
      }
    },
    "accounting": {
      "timezone": "UTC",
      "week_start": 0,
      "storage": {
        "database": "telemetry/events.sqlite",
        "lock": "telemetry/events.lock"
      },
      "max_events": 1000,
      "max_files": 1000,
      "max_blob_bytes": 1048576,
      "time_mode": "tool_cycle",
      "causes": [
        "initial",
        "internal_qa",
        "delivered_rework",
        "requirement_change",
        "poise_incident"
      ],
      "sources": {
        "test": "reported",
        "codex": "observed"
      },
      "path_categories": {
        "code": [
          "src/**"
        ],
        "tests": [
          "tests/**"
        ],
        "fixtures": [
          "fixtures/**"
        ],
        "documentation": [
          "docs/**",
          "*.md"
        ]
      },
      "tokenizer": {
        "kind": "unavailable",
        "identity": "not-configured",
        "command": null
      }
    }
  },
  "questions": [
    {
      "id": "project",
      "path": [
        "project"
      ],
      "type": "text",
      "prompt": "Project identifier"
    },
    {
      "id": "repository",
      "path": [
        "git",
        "repository"
      ],
      "type": "text",
      "prompt": "Absolute Git repository root"
    },
    {
      "id": "base",
      "path": [
        "git",
        "base_ref"
      ],
      "type": "text",
      "prompt": "Exact base ref to resolve locally"
    },
    {
      "id": "remote",
      "path": [
        "git",
        "remote"
      ],
      "type": "text",
      "prompt": "Git remote name (still explicit when push is disabled)"
    },
    {
      "id": "author_name",
      "path": [
        "git",
        "author_name"
      ],
      "type": "text",
      "prompt": "Commit author name"
    },
    {
      "id": "author_email",
      "path": [
        "git",
        "author_email"
      ],
      "type": "text",
      "prompt": "Commit author email"
    },
    {
      "id": "push",
      "path": [
        "git",
        "push_required"
      ],
      "type": "boolean",
      "prompt": "Require push of verified task branch"
    },
    {
      "id": "state",
      "path": [
        "paths",
        "state"
      ],
      "type": "text",
      "prompt": "Explicit project data root (the project directory, without an extra state layer)"
    },
    {
      "id": "environment",
      "path": [
        "environment_names"
      ],
      "type": "strings",
      "prompt": "Names of inherited environment variables"
    },
    {
      "id": "worktrees",
      "path": [
        "paths",
        "worktrees"
      ],
      "type": "text",
      "prompt": "Explicit absolute Task worktree directory inside the selected code repository"
    }
  ],
  "workflow_sources": {
    "analysis": {
      "path": "config/catalogue/workflows/analysis.json",
