{
  "schema": "stride-launcher-1",
  "poise_root": "${LAUNCHER_ROOT}",
  "data_root": "${PROJECT_DATA_PARENT_ROOT}",
  "project_id": "${PROJECT_ID}",
  "project_setup": "app/config/project-setup.json",
  "command": [
    "${PYTHON_EXECUTABLE}",
    "-P",
    "-s",
    "-B",
    "-m",
    "poise"
  ],
  "overrides": {
    "next": [
      "${PYTHON_EXECUTABLE}",
      "-P",
      "-s",
      "-B",
      "-m",
      "poise",
      "next",
      "--settings",
      "${POISE_SOURCE_ROOT}/config/project-setup.json"
    ]
  },
  "exit_codes": {
    "rejected": 2
  }
}
