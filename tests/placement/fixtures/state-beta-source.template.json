{
  "schema": "poise-placement-state-1",
  "project": "@PROJECT@",
  "checkout": "@CHECKOUT@",
  "caller_key": "@CALLER_KEY@",
  "baseline": {
    "entries": [
      ".git",
      "AGENTS.md",
      "docs",
      "src"
    ]
  },
  "authorizations": [],
  "reservations": [
    {
      "key": "source-report",
      "purpose": "source",
      "recipient": "product",
      "lifetime": "versioned",
      "name": "report.py",
      "root": "product",
      "owner": {
        "kind": "product",
        "id": "@PROJECT@"
      },
      "category": "beta-product-versioned",
      "rule": "source",
      "path": "src/beta/report.py",
      "absolute_path": "@CHECKOUT@/src/beta/report.py",
      "authorization_refs": [
        "configured-product"
      ],
      "versioning": "versioned"
    }
  ]
}
