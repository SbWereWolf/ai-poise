+    def test_optional_cancellation_release_failure_preserves_result_and_responsiveness(self) -> None:
+        self.admit_mcp(self.public_arguments())
+        arguments = {**self.admit_cancel(), "verbose": True}
+        corrupt = b"unit-owned registry failed after cancellation\n"
+        with self.server_transport(self.env.primary) as (server, responses):
+            with self.request_states(server) as (own, foreign):
+                cancel = own.request_force_cancel
+
+                def cancel_then_corrupt(*args, **kwargs):
+                    result = cancel(*args, **kwargs)
+                    gc.collect()
+                    self.env.registry.path.write_bytes(corrupt)
+                    return result
+
+                leaked = None
+                with patch.object(own, "request_force_cancel", side_effect=cancel_then_corrupt):
+                    try:
+                        server.handle(self.cancel_message(arguments))
+                    except sqlite3.DatabaseError as error:
+                        leaked = error
+                self.assertTrue(own.cancelled)
+                self.assertTrue(own.cancel_event.is_set())
+                self.assertFalse(foreign.cancelled)
+                self.assertFalse(foreign.cancel_event.is_set())
+                self.assertEqual(self.env.registry.path.read_bytes(), corrupt)
+                self.assert_foreign_checkout_unchanged()
+                self.assertIsNone(leaked, "Optional release escaped after actual cancellation")
+                matching = [response for response in responses if response.get("id") == 12]
+                self.assertEqual(len(matching), 1)
+                envelope = matching[0]["result"]
+                result = envelope["structuredContent"]
+                self.assertEqual(result["status"], "cancelled")
+                self.assertFalse(result["lock_released"])
+                self.assertTrue(result["cleanup_completed"])
+                warnings = [warning for item in envelope["content"]
+                            if item.get("type") == "text" and item["text"].startswith("{")
+                            for warning in json.loads(item["text"]).get("warnings", [])]
+                self.assertEqual(len(warnings), 1)
+                self.assertIn("Optional tracking completion unavailable", warnings[0])
+                server.handle({"jsonrpc": "2.0", "id": 13, "method": "tools/list", "params": {}})
+                self.assertEqual([tool["name"] for tool in self.response_for(responses, 13)["result"]["tools"]],
+                                 ["run", "cancel"])
