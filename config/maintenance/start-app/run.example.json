{
  "requirements": [
    {
      "id": "selected-poise-cli",
      "commands": [
        {
          "argv": [
            "${bash}",
            "-o",
            "pipefail",
            "-c",
            "\"$$@\" | \"$$POISE_JQ\" --raw-input --slurp --join-output \"$$POISE_RESULT_FILTER\"",
            "poise-result",
            "${python}",
            "-P",
            "-s",
            "-B",
            "-m",
            "poise",
            "project",
            "list",
            "--settings",
            "${profile_root}/setup.json"
          ],
          "cwd": "${repository}",
          "env": {
            "PYTHONPATH": "${runtime_module_path}",
            "PYTHONDONTWRITEBYTECODE": "1",
            "LANG": "C.UTF-8",
            "POISE_JQ": "${jq}",
            "POISE_RESULT_FILTER": "${project_list_result_filter}"
          },
          "interpreter": {
            "name": "project-list",
            "options": {
              "accept": [
                0
              ],
              "projects_field": "projects",
              "errors_field": "errors",
              "minimum_project_count": 1
            }
          }
        }
      ]
    }
  ]
}
