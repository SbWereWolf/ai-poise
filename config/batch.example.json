{
  "artifact_directories": {
    "runtime": "generated",
    "sprint": "artifacts",
    "task": "artifacts"
  },
  "artifact_lock": "artifact.lock",
  "file_mode": 384,
  "initial_read_lines": 50,
  "max_artifact_bytes": 262144,
  "max_input_bytes": 1048576,
  "max_items": 1000,
  "message_reasons": [
    "initial",
    "continue",
    "feedback",
    "requirement_change",
    "clarification",
    "authorization",
    "cancel"
  ],
  "message_source": {
    "id": "codex-hook-main",
    "mode": "runtime_event"
  },
  "templates": {
    "note": {
      "parameters": [
        "title",
        "body"
      ],
      "text": "# ${title}\n\n${body}\n",
      "version": "1"
    }
  }
}
