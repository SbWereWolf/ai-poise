+    def run_admitted(self, decision: dict, physical_root: Path, *, expected_marker: str = "executed\n") -> dict:
+        tokens = shlex.split(decision["updatedInput"]["command"])
+        cwd = self.event_cwd
+        if tokens[:1] == ["cd"] and tokens[2:3] == ["&&"]:
+            cwd = Path(tokens[1])
+            tokens = tokens[3:]
+        argv = tokens[3:]
+        output, error = io.StringIO(), io.StringIO()
+        with (
+            contextlib.chdir(cwd),
+            patch.object(binding.runner_cli, "repository_root", return_value=physical_root),
