{
  "schema": "environment-maintenance/requirements/v1",
  "parameters": {
    "python": {
      "type": "string",
      "default": "python3"
    },
    "module_path": {
      "type": "string",
      "default": ""
    },
    "profile_root": {
      "type": "string",
      "default": ""
    },
    "state_root": {
      "type": "string",
      "default": ""
    },
    "repository": {
      "type": "string",
      "default": ""
    },
    "project_id": {
      "type": "string",
      "default": ""
    },
    "base_ref": {
      "type": "string",
      "default": "main"
    },
    "author_name": {
      "type": "string",
      "default": ""
    },
    "author_email": {
      "type": "string",
      "default": ""
    },
    "git": {
      "type": "string",
      "default": "git"
    },
    "directory_mode": {
      "type": "string",
      "default": "0750"
    },
    "python_minimum": {
      "type": "string",
      "default": "3.13"
    },
    "python_maximum": {
      "type": "string",
      "default": "3.14"
    },
    "template_id": {
      "type": "string",
      "default": "linux-reference"
    },
    "remote": {
      "type": "string",
      "default": "disabled"
    }
  },
  "inherit_env": [
    "PATH",
    "HOME",
    "LANG"
  ],
  "requirements": [
    {
      "id": "python-runtime",
      "kind": "deps",
      "check": {
        "repair": "python-runtime"
      },
      "apply": {
        "repair": "python-runtime"
      },
      "recommendation": {
        "repair": "python-runtime"
      }
    },
    {
      "id": "git-executable",
      "kind": "deps",
      "check": {
        "argv": [
          "${git}",
          "--version"
        ],
        "timeout": 10
      },
      "apply": {
        "argv": [
          "apt-get",
          "install",
          "--yes",
          "git"
        ],
        "timeout": 120
      },
      "recommendation": "Git недоступен. Укажите установленный Git через --set git=/path/git либо установите пакет git средствами Ubuntu. Команда deps не повышает привилегии."
    },
    {
      "id": "target-repository",
      "kind": "infra",
      "check": {
        "repair": "target-repository"
      },
      "apply": {
        "repair": "target-repository"
      },
      "recommendation": {
        "repair": "target-repository"
      }
    },
    {
      "id": "state-root",
      "kind": "infra",
      "check": {
        "repair": "state-root"
      },
      "apply": {
        "repair": "state-root"
