+            patch.dict(os.environ, {
+                "AGENT_ARTIFACT_SESSION_ID": "provider-binding-contract",
+                "PROVIDER_BINDING_CHILD_EXIT": "0",
+            }),
+            contextlib.redirect_stdout(output),
+            contextlib.redirect_stderr(error),
+        ):
+            code = binding.runner_cli.main(argv)
+        self.assertEqual(code, 0, error.getvalue())
+        result = json.loads(output.getvalue())
+        self.assertEqual(result["status"], "passed")
+        self.assertEqual(result["verified_success"], True)
+        self.assertEqual((self.env.subject / "ran.txt").read_text(), expected_marker)
