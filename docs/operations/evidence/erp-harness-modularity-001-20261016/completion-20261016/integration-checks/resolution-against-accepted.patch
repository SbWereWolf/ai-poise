+def profile_selection_diagnostic(
+    message: str, *, source_root: Path, subject_root: Path, profile_path: Path,
+) -> str:
+    """Report actual selected identities without deriving one root from another."""
+    return redact(
+        f"{message} Selected source={source_root}; subject={subject_root}; catalogue={profile_path}."
+    )
+
+
+PROFILE_LOADING_ERRORS = (profile_contracts.ProfileError, OSError, tomllib.TOMLDecodeError, UnicodeDecodeError)
+
+
+def exception_diagnostic(error: BaseException) -> str:
+    message = str(error)
+    if hasattr(error, "__notes__"):
+        message += "\n" + "\n".join(error.__notes__)
+    return redact(message)
+
+
+@contextmanager
+def profile_loading_context(*, profile_path: Path, source_root: Path, subject_root: Path):
+    """Keep catalogue diagnostics consistent without replacing the loader or exception."""
+    try:
+        yield
+    except PROFILE_LOADING_ERRORS as error:
+        recovery = (
+            "Contact a system administrator to restore read access to the selected catalogue, then retry the check."
+            if isinstance(error, PermissionError)
+            else "Restore the selected catalogue as readable UTF-8 TOML with schema_version=1, then retry the check."
+        )
+        error.add_note(profile_selection_diagnostic(
+            recovery, source_root=source_root, subject_root=subject_root, profile_path=profile_path.resolve(),
+        ))
+        raise
+
+
+def load_selected_profiles(
+    profile_path: Path, *, source_root: Path, subject_root: Path,
+) -> profile_contracts.ProfileSet:
+    """Load the selected catalogue, preserving original read/parse exceptions."""
+    with profile_loading_context(profile_path=profile_path, source_root=source_root, subject_root=subject_root):
+        return profile_contracts.load_profiles(profile_path)
+
+
+def validate_timeout_arguments(timeout: object, evidence: object, reason: object) -> None:
+    if timeout is not None and (type(timeout) is not int or timeout <= 0):
+        raise profile_contracts.ProfileError("timeout_override must be a positive integer")
+    values = (timeout, evidence, reason)
+    if any(item is not None for item in values) and not all(item is not None for item in values):
+        raise profile_contracts.ProfileError("timeout_override, timeout_evidence, and override_reason must be supplied together")
+
+
+def parse_public_run_arguments(value: object) -> dict[str, Any]:
+    """The canonical public run grammar shared by admission and MCP."""
+    if not isinstance(value, Mapping):
+        raise profile_contracts.ProfileError("run arguments must be an object")
+    allowed = {
+        "command_id", "workload_class", "runtime_class", "fresh",
+        "timeout_override", "timeout_evidence", "override_reason", "dry_run", "verbose",
+        "project_root", "config_root",
+    }
+    warnings = [f"Unrecognized option {name} ignored." for name in sorted(set(value) - allowed)]
+    result: dict[str, Any] = {"warnings": warnings}
+    for name in ("project_root", "config_root"):
+        item = value.get(name)
+        if item is not None:
+            if not isinstance(item, str) or not item.strip() or not Path(item).is_absolute():
+                raise profile_contracts.ProfileError(f"{name} must identify an absolute existing directory.")
+            if not Path(item).is_dir():
+                raise profile_contracts.ProfileError(f"{name} directory is unavailable. Select an existing directory.")
+            item = str(Path(item).resolve())
+        result[name] = item
+    for name, maximum in (
+        ("command_id", 96), ("workload_class", 96), ("runtime_class", 96),
+        ("timeout_evidence", 128), ("override_reason", 1000),
+    ):
+        item = value.get(name)
+        if item is not None:
+            if not isinstance(item, str) or not item.strip() or len(item.strip()) > maximum:
+                if name == "command_id":
+                    raise profile_contracts.ProfileError(f"{name} must be a nonempty string of at most {maximum} characters")
+                warnings.append(f"Invalid optional option {name} ignored: expected nonempty string.")
+                item = None
+            else:
+                item = item.strip()
+        result[name] = item
+    if result["command_id"] is None:
+        raise profile_contracts.ProfileError("command_id is required")
+    for name in ("fresh", "dry_run", "verbose"):
+        item = value.get(name)
+        if item is not None and type(item) is not bool:
+            if name == "dry_run":
+                raise profile_contracts.ProfileError("Cannot determine operation: dry_run must be boolean.")
+            warnings.append(f"Invalid optional option {name} ignored: expected boolean.")
+            item = None
+        result[name] = item is True
+    timeout = value.get("timeout_override")
+    result["timeout_override"] = timeout
+    try:
+        validate_timeout_arguments(timeout, result["timeout_evidence"], result["override_reason"])
+    except profile_contracts.ProfileError:
+        warnings.append("Invalid optional timeout override ignored.")
+        for name in ("timeout_override", "timeout_evidence", "override_reason"):
+            result[name] = None
+    return result
+
+
+def parse_runner_arguments(argv: Sequence[str] | None = None) -> argparse.Namespace:
+    """Use the shared public grammar while retaining CLI operation/target fields."""
+    args, unknown = build_runner_parser().parse_known_args(argv)
+    public = {name: getattr(args, name) for name in (
+        "workload_class", "runtime_class", "fresh", "dry_run", "verbose",
+        "timeout_override", "timeout_evidence", "override_reason",
+    )}
+    if public["timeout_override"] is not None:
+        try:
+            public["timeout_override"] = int(public["timeout_override"])
+        except ValueError:
+            pass
+    for name in ("fresh", "dry_run", "verbose"):
+        if isinstance(public[name], str) and public[name].lower() in ("true", "false"):
+            public[name] = public[name].lower() == "true"
+    public["command_id"] = args.command_id or args.describe or "list"
+    parsed = parse_public_run_arguments(public)
+    for name, item in parsed.items():
+        if name not in {"command_id", "project_root", "config_root"}:
+            setattr(args, name, item)
+    args.warnings.extend(f"Unrecognized option {name} ignored." for name in unknown if name.startswith("-"))
+    return args
+
+
+def parse_public_cancel_arguments(value: object) -> dict[str, Any]:
+    if not isinstance(value, Mapping):
+        raise profile_contracts.ProfileError("cancel arguments must be an object")
+    warnings = [f"Unrecognized option {name} ignored." for name in sorted(set(value) - {"reason", "dry_run", "verbose"})]
+    result: dict[str, Any] = {"warnings": warnings}
+    reason = value.get("reason")
+    if reason is not None and (not isinstance(reason, str) or not reason.strip() or len(reason.strip()) > 1000):
+        warnings.append("Invalid optional option reason ignored: expected nonempty string.")
+        reason = None
+    result["reason"] = reason.strip() if reason is not None else None
+    for name in ("dry_run", "verbose"):
+        item = value.get(name)
+        if item is not None and type(item) is not bool:
+            if name == "dry_run":
+                raise profile_contracts.ProfileError("Cannot determine operation: dry_run must be boolean.")
+            warnings.append(f"Invalid optional option {name} ignored: expected boolean.")
+        result[name] = item is True
+    return result
+
+
+def select_run_profile(profiles: profile_contracts.ProfileSet, arguments: dict[str, Any], platform_name: str) -> profile_contracts.CommandProfile:
+    """Ignore unrecognized optional selectors; require an unambiguous command."""
+    candidates = [item for item in profiles.profiles if item.command_id == arguments["command_id"] and platform_name in item.platforms]
+    for name in ("workload_class", "runtime_class"):
+        item = arguments[name]
+        if candidates and item is not None and not any(getattr(profile, name) == item for profile in candidates):
+            arguments["warnings"].append(f"Unrecognized optional option {name} ignored.")
+            arguments[name] = None
+    return profiles.select(arguments["command_id"], platform_name=platform_name,
+                           workload_class=arguments["workload_class"], runtime_class=arguments["runtime_class"])
+
+
+def run_preview(repository_root: Path, profile: profile_contracts.CommandProfile, warnings: list[str], *, configuration_root: Path | None = None) -> dict[str, Any]:
+    return {
+        "schema_version": 1, "result_kind": "dry_run", "operation": "run",
+        "command_id": profile.command_id, "workload_class": profile.workload_class,
+        "runtime_class": profile.runtime_class, "repository_root": str(repository_root),
+        "configuration_root": str(configuration_root if configuration_root is not None else repository_root),
+        "argv": resolve_command(profile), "cwd": str((repository_root / profile.cwd).resolve()),
+        "warnings": warnings,
+    }
+
+
+def build_runner_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description="Run one registered command and return a bounded result.",
+        allow_abbrev=False,
+    )
+    operation = parser.add_mutually_exclusive_group(required=True)
+    operation.add_argument("--command-id")
+    operation.add_argument("--list", action="store_true")
+    operation.add_argument("--describe")
+    parser.add_argument("--workload-class", nargs="?", const="")
+    parser.add_argument("--runtime-class", nargs="?", const="")
+    parser.add_argument("--project-root", help="Execute against an authorized Git checkout.")
+    parser.add_argument("--config-root", help="Read harness configuration from this directory; execution subject is unchanged.")
+    parser.add_argument("--timeout-override", nargs="?", const="")
+    parser.add_argument("--timeout-evidence", nargs="?", const="")
+    parser.add_argument("--override-reason", nargs="?", const="")
+    parser.add_argument(
+        "--fallback-reason",
+        choices=(
+            "mcp-call-failed",
+            "mcp-project-untrusted",
+            "mcp-server-unhealthy",
+            "mcp-tool-unavailable",
+        ),
+        help=(
+            "Codex-hook telemetry for the one MCP-unavailable direct "
+            "fallback. It does not change command execution."
+        ),
+    )
+    parser.add_argument(
+        "--fresh",
+        nargs="?", const=True, default=False,
+        help="Ignore a reusable successful intermediate result and execute the command.",
+    )
+    parser.add_argument("--adoption-scope-key", help=argparse.SUPPRESS)
+    parser.add_argument("--adoption-tool-use-id", help=argparse.SUPPRESS)
+    parser.add_argument("--adoption-registry-path", help=argparse.SUPPRESS)
+    parser.add_argument("--json", action="store_true")
+    parser.add_argument("--dry-run", nargs="?", const=True, default=False, help="Resolve the operation and warnings without executing it.")
+    parser.add_argument("--verbose", nargs="?", const=True, default=False, help="Include unapplied optional-argument warnings.")
+    return parser
