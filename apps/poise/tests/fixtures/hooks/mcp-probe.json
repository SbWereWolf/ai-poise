{
  "id": "@PROBE@",
  "kind": "mcp_stdio",
  "required": true,
  "argv": [
    "@PYTHON@",
    "-I",
    "-S",
    "-B",
    "@GENERIC_PEER@",
    "mcp"
  ],
  "cwd": "${workspace}",
  "environment": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "TRACE": "@TRACE@"
  },
  "timeout_seconds": 2,
  "max_output_bytes": 32768,
  "expected_exit_code": 0,
  "stdout_contains": [],
  "stderr_contains": [],
  "json_assertions": [
    {
      "path": [
        "structuredContent",
        "checkout"
      ],
      "equals": "${workspace}"
    }
  ],
  "mcp": {
    "protocol_version": "2024-11-05",
    "client_info": {
      "name": "independent-hook-client",
      "version": "1"
    },
    "required_tools": [
      "find_symbol"
    ],
    "call": {
      "name": "find_symbol",
      "arguments": {
        "checkout": "${workspace}",
        "name": "candidate"
      },
      "read_only": true
    },
    "max_messages": 16,
    "max_pages": 4,
    "max_message_bytes": 16384,
    "shutdown_seconds": 1
  },
  "tool_ref": "fixture.hook-probe",
  "project_bound": true,
  "remediation": "Configure the read-only fixture probe."
}
