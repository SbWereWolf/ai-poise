
.venv/
__pycache__/
.pytest_cache/
*.pyc
*.egg-info/
build/
dist/
**/.python/
**/.runtime/
**/sprint/
**/task/

# Local mutable data for the configured ai-poise project
/projects/**

# Generated IDE project state
/.idea/

# Installation-specific working configuration; version only examples/templates.
/.codex/hooks.json
/config/project-setup.json
/config/project-registry.json
/config/goal-editor.json
/config/catalogue/settings.json
/config/projects/ai-poise/*
!/config/projects/ai-poise/project.example.json
!/config/projects/ai-poise/hooks-settings.example.json

# AI-poise codebase-owned test package cache
.poise-test-cache/

# Local source-search profile; version its example, not working settings.
/.ast-index.yaml

# Installation-specific Stride bootstrap and settings; retain sanitized examples.
/config/stride.env
/config/stride-launcher.json

# Operator-owned working maintenance settings; commit populated examples only.
/config/bootstrap.json
/config/environment-maintenance.json
/operator/profile/

# Working catalogue editor settings; retain its sanitized example.
/config/catalogue/editor.json
