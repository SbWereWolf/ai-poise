{
  "accounting": {
    "causes": [
      "initial",
      "internal_qa",
      "delivered_rework",
      "requirement_change",
      "poise_incident"
    ],
    "max_blob_bytes": 1048576,
    "max_events": 1000,
    "max_files": 1000,
    "path_categories": {
      "code": [
        "src/**"
      ],
      "documentation": [
        "docs/**",
        "*.md"
      ],
      "fixtures": [
        "fixtures/**"
      ],
      "tests": [
        "tests/**"
      ]
    },
    "sources": {
      "codex": "observed",
      "test": "reported"
    },
    "storage": {
      "database": "telemetry/events.sqlite",
      "lock": "telemetry/events.lock"
    },
    "time_mode": "tool_cycle",
    "timezone": "UTC",
    "tokenizer": {
      "command": null,
      "identity": "not-configured",
      "kind": "unavailable"
    },
    "week_start": 0
  },
  "automatic_checks": [],
  "batch": {
    "artifact_directories": {
      "runtime": "generated",
      "sprint": "artifacts",
      "task": "artifacts"
    },
    "file_mode": 384,
    "initial_read_lines": 50,
    "max_artifact_bytes": 262144,
    "max_input_bytes": 1048576,
    "max_items": 1000,
    "message_reasons": [
      "initial",
      "continue",
      "feedback",
      "requirement_change",
      "clarification",
      "authorization",
      "cancel"
    ],
    "message_source": {
      "id": "codex-hook-main",
      "mode": "runtime_event"
    },
    "templates": {
      "note": {
        "parameters": [
          "title",
          "body"
        ],
        "text": "# ${title}\n\n${body}\n",
        "version": "1"
      }
    }
  },
  "environment_names": [
    "PATH",
    "HOME"
  ],
  "git": {
    "author_email": "${COMMIT_AUTHOR_EMAIL}",
    "author_name": "${COMMIT_AUTHOR_NAME}",
    "base_ref": "master",
    "branch_template": "tasks/{task_id}",
    "commit_pattern": "(?s).+",
    "push_required": false,
    "remote": "origin",
    "repository": "${REPOSITORY_ROOT}"
  },
  "limits": {
    "git_seconds": 15.0,
    "lock_poll_seconds": 0.01,
    "lock_seconds": 2.0,
    "sqlite_read_seconds": 2.0,
    "output_chars": 2200,
    "preview_chars": 300,
    "verify_attempts": 5
  },
  "paths": {
    "database": "tasks/tasks.sqlite",
    "git_index": "snapshot.index",
    "lock": "tasks/tasks.lock",
    "requirements_database": "${PROJECT_DATA_ROOT}/requirements/requirements.sqlite",
    "requirements_lock": "${PROJECT_DATA_ROOT}/requirements/requirements.lock",
    "requirements_schema_migrations": "${POISE_ROOT}/config/migrations/requirements",
    "requirements_data_migrations": "${PROJECT_ROOT}/docs/requirements/data",
    "requirements_schema_file": "${PROJECT_ROOT}/docs/requirements/schema.sql",
    "response": "response.json",
    "runs": "runs",
    "runtime": ".runtime",
    "sprints": "sprint",
    "standalone_tasks": "standalone",
    "state": "${PROJECT_DATA_ROOT}",
    "stderr": "stderr.txt",
    "stdout": "stdout.txt",
    "worktrees": "worktrees"
  },
  "project": "${PROJECT_ID}",
  "runtime_services": {
    "check_runner": {
      "diagnostic_override_max_seconds": 900,
      "history_multiplier": 1.1,
      "initial_seconds": 120,
      "poll_seconds": 0.1,
      "progress_gap_seconds": 120
    },
    "output": {
      "chunk_bytes": 65536,
      "directory": "views",
      "file_mode": 384,
      "job": "job.json",
      "known": [
        {
          "argv_tokens": [
            "-m",
            "unittest"
          ],
          "extended_bytes": 4096,
          "files": {
            "extended": "extended.txt",
            "full": "full.txt",
            "selected": "selected.txt"
          },
          "id": "unittest",
          "parser": "lines",
          "primary_chars": 512,
          "selected_bytes": 4096,
          "selection_pattern": "^(Ran [0-9]+ test|OK|FAILED|FAIL:|ERROR:).*"
        }
      ],
      "manifest": "views.json",
      "unknown": {
        "argv_tokens": [],
        "extended_bytes": 4096,
        "files": {
          "extended": "extended.txt",
          "full": "full.txt",
          "selected": null
        },
        "id": "unknown",
        "parser": "tail",
        "primary_chars": 512,
        "selected_bytes": 4096,
        "selection_pattern": null
      },
      "worker_stderr": "worker-err.txt",
      "worker_stdout": "worker-out.txt",
      "worker_timeout_seconds": 15
    }
  },
  "schema": "ddd-accounting-12",
  "sprint": {
    "acceptable_terminal_states": [
      "completed",
      "cancelled"
    ],
    "max_dependencies": 3000,
    "max_tasks": 1000,
    "section_rules": [
      {
        "name": "plan",
        "normalization": "strip",
        "required": true,
        "template": "Заполнить план."
      }
    ],
    "templates": {
      "basic": {
        "definition_of_done": [],
        "dependencies": [],
        "goal": "",
        "requirements": [],
        "sections": {
          "plan": "Заполнить план."
        },
        "tasks": [],
        "version": "1"
      }
    }
  },
  "task_decomposition": {
    "areas": [
      {
        "path": "src/**",
        "responsibility": "ai-poise"
      },
      {
        "path": "tests/**",
        "responsibility": "ai-poise"
      },
      {
        "path": "config/**",
        "responsibility": "project-configuration"
      },
      {
        "path": "docs/**",
        "responsibility": "documentation"
      },
      {
        "path": ".agents/**",
        "responsibility": "agent-instructions"
      },
      {
        "path": "AGENTS.md",
        "responsibility": "agent-instructions"
      },
      {
        "path": ".gitignore",
        "responsibility": "ai-poise"
      },
      {
        "path": "README.md",
        "responsibility": "ai-poise"
      },
      {
        "path": "fixtures/**",
        "responsibility": "ai-poise"
      },
      {
        "path": "pyproject.toml",
        "responsibility": "ai-poise"
      },
      {
        "path": "requirements*.txt",
        "responsibility": "ai-poise"
      },
      {
        "path": "stride.sh",
        "responsibility": "ai-poise"
      },
      {
        "path": "uv.lock",
        "responsibility": "ai-poise"
      },
      {
        "path": "bootstrap",
        "responsibility": "ai-poise"
      },
      {
        "path": "apps/bootstrap/**",
        "responsibility": "ai-poise"
      }
    ],
    "skills": [
      {
        "class": "meta",
        "id": "poise-workflow",
        "responsibility": null
      },
      {
        "class": "general",
        "id": "poise-development",
        "responsibility": null
      },
      {
        "class": "general",
        "id": "ast-index",
        "responsibility": null
      },
      {
        "class": "narrow",
        "id": "task-domain",
        "responsibility": "tasks"
      },
      {
        "class": "narrow",
        "id": "sprint-domain",
        "responsibility": "sprints"
      },
      {
        "class": "narrow",
        "id": "verification-domain",
        "responsibility": "verification"
      },
      {
        "class": "narrow",
        "id": "project-configuration",
        "responsibility": "project-configuration"
      }
    ]
  },
  "task_ids": {
    "namespace": {
      "maximum": 9999,
      "minimum": 1
    },
    "progression": {
      "first": 1,
      "step": 1
    },
    "width": 4
  },
  "task_planning": {
    "catalogue": "${POISE_SOURCE_ROOT}/config/catalogue/settings.json",
    "restart_revision_policy": {
      "reviewer": [
        "goal",
        "requirements",
        "requirements_snapshot",
        "requirements_agreement",
        "stage_contracts",
        "workflow"
      ],
      "user": [
        "goal",
        "goal_type",
        "requirements",
        "requirements_snapshot",
        "requirements_agreement",
        "definition_of_done",
        "methods",
        "method_inputs",
        "checks",
        "artifact_requirements",
        "content_contract",
        "evidence_plan",
        "executable_obligations",
        "stage_contracts",
        "decomposition",
        "workflow",
        "planning"
      ]
    }
  },
  "runtime_resources": {
    "project_setup": "${POISE_SOURCE_ROOT}/config/project-setup.json",
    "hooks": [
      {
        "installation_id": "poise-main",
        "settings_path": "${PROJECT_CONFIG_ROOT}/hooks-data-settings.json"
      }
    ]
  },
  "workflows": {
    "analysis": "${PROJECT_DATA_ROOT}/workflows/analysis.json",
    "design": "${PROJECT_DATA_ROOT}/workflows/design.json",
    "development": "${PROJECT_DATA_ROOT}/workflows/development.json",
    "documentation": "${PROJECT_DATA_ROOT}/workflows/documentation.json",
    "environment_diagnostics": "${PROJECT_DATA_ROOT}/workflows/environment_diagnostics.json",
    "environment_remediation": "${PROJECT_DATA_ROOT}/workflows/environment_remediation.json",
    "integration": "${PROJECT_DATA_ROOT}/workflows/integration.json",
    "profiling": "${PROJECT_DATA_ROOT}/workflows/profiling.json",
    "review": "${PROJECT_DATA_ROOT}/workflows/review.json",
    "sprint_planning": "${PROJECT_DATA_ROOT}/workflows/sprint_planning.json",
    "task_planning": "${PROJECT_DATA_ROOT}/workflows/task_planning.json",
    "test_development": "${PROJECT_DATA_ROOT}/workflows/test_development.json",
    "verification": "${PROJECT_DATA_ROOT}/workflows/verification.json"
  }
}
