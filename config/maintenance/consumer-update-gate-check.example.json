{
  "requirements": [
    {
      "id": "all-registered-consumers",
      "commands": [
        {
          "argv": [
            "${python}",
            "-B",
            "${observer}",
            "--config",
            "${consumer_config}"
          ],
          "cwd": "${base}",
          "env": {
            "PATH": "${path}",
            "HOME": "${home}",
            "PYTHONPATH": "${module_path}",
            "LANG": "C.UTF-8"
          },
          "interpreter": {
            "name": "exit",
            "options": {
              "accept": [
                0
              ]
            }
          }
        }
      ]
    }
  ]
}
