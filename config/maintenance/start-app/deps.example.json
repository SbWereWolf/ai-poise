                "${python}",
                "-B",
                "-m",
                "poise_environment.repairs.python_runtime",
                "--minimum",
                "${python_minimum}",
                "--maximum",
                "${python_maximum}",
                "--requirement-id",
                "python-runtime",
                "--action",
                "check",
                "--schema",
                "poise/maintenance-action/v2",
                "--recommendations",
                "${profile_root}/recommendations.json"
              ],
              "cwd": "${profile_root}",
              "env": {
                "PYTHONPATH": "${runtime_module_path}",
                "PYTHONDONTWRITEBYTECODE": "1",
                "LANG": "C.UTF-8",
                "POISE_JQ": "${jq}",
                "POISE_RESULT_FILTER": "${resource_result_filter}",
                "POISE_RESULT_SCHEMA": "poise/maintenance-action/v2",
                "POISE_RESULT_FIELD": "state",
                "POISE_RESULT_EXPECTED": "satisfied"
              },
              "interpreter": {
                "name": "resource",
                "options": {
                  "accept": [
                    0
                  ],
                  "schema": "poise/maintenance-action/v2",
                  "field": "state",
                  "values": [
                    "satisfied"
                  ]
                }
              }
            }
          ]
        }
      }
    },
