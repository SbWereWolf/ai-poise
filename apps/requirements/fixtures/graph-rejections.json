  "cases": [
    {
      "id": "stale_store",
      "method": "apply",
      "input": {
        "request_id": "stale-store",
        "expected_revision": 6,
        "operations": [
          {
            "kind": "revise_task",
            "task_id": "000007",
            "expected_statement_revision": 2,
            "statement": {
              "goal": "Сохранить сквозную трассировку.",
              "task_requirements": [
                {
                  "key": "R1",
                  "status": "current",
                  "text": "Сохранить первую связь.",
                  "applications": [
                    "APP-A",
                    "APP-B"
                  ]
                },
                {
                  "key": "R2",
                  "status": "current",
                  "text": "Сохранить обе связи.",
                  "applications": [
                    "APP-A",
                    "APP-B"
                  ]
                },
                {
                  "key": "RF",
                  "status": "future",
                  "text": "Запланировать развитие.",
                  "applications": [
                    "APP-F"
                  ]
                },
                {
                  "key": "RP",
                  "status": "future",
                  "text": "",
                  "applications": [
                    "APP-ONLY-PLACE"
                  ]
                },
                {
                  "key": "RO",
                  "status": "obsolete",
                  "text": "Устаревшее требование.",
                  "applications": [
                    "APP-O"
                  ]
                }
              ],
              "definition_of_done": [
                "Связи и ревизии читаются."
              ]
            }
          }
        ]
      },
      "message_tokens": [
        "revision"
      ],
      "existing_guard": true
    },
