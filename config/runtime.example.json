{
  "check_runner": {
    "diagnostic_override_max_seconds": 900,
    "history_multiplier": 1.1,
    "initial_seconds": 120,
    "poll_seconds": 0.1,
    "progress_gap_seconds": 120
  },
  "output": {
    "chunk_bytes": 65536,
    "directory": "views",
    "file_mode": 384,
    "job": "job.json",
    "known": [
      {
        "argv_tokens": [
          "-m",
          "unittest"
        ],
        "extended_bytes": 4096,
        "files": {
          "extended": "extended.txt",
          "full": "full.txt",
          "selected": "selected.txt"
        },
        "id": "unittest",
        "parser": "lines",
        "primary_chars": 512,
        "selected_bytes": 4096,
        "selection_pattern": "^(Ran [0-9]+ test|OK|FAILED|FAIL:|ERROR:).*"
      }
    ],
    "manifest": "views.json",
    "unknown": {
      "argv_tokens": [],
      "extended_bytes": 4096,
      "files": {
        "extended": "extended.txt",
        "full": "full.txt",
        "selected": null
      },
      "id": "unknown",
      "parser": "tail",
      "primary_chars": 512,
      "selected_bytes": 4096,
      "selection_pattern": null
    },
    "worker_stderr": "worker-err.txt",
    "worker_stdout": "worker-out.txt",
    "worker_timeout_seconds": 15
  }
}
