{
  "schema": "poise-maintenance-profile-1",
  "catalog": "config/projects/erp/catalog.example.json",
  "settings": "config/project-setup.example.json",
  "recommendations": "config/projects/erp/recommendations.example.json",
  "templates": {
    "linux-reference": "config/project-templates/linux-reference.json"
  },
  "asset_directories": [
    {
      "source": "config/catalogue",
      "destination": "config/catalogue",
      "patterns": [
        "settings.example.json",
        "editor.example.json",
        "task-templates/*.json",
        "workflow-templates/*.json",
        "workflows/*.json"
      ]
    },
    {
      "source": "${module_path}/poise_environment/erp/runtime",
      "destination": "runtime",
      "patterns": [
        "*.php",
        "*.mjs"
      ]
    }
  ],
  "workflow_source_prefix": "app/",
  "outputs": {
    "catalog": "catalog.json",
    "settings": "setup.json",
    "registry": "configured-projects.json",
    "edits": "project-edits.json",
    "recommendations": "recommendations.json"
  },
  "settings_overrides": {
    "root": ".",
    "registry": "configured-projects.json",
    "lock": "setup.lock"
  },
  "preserve_paths": [
    "project",
    "configured-projects.json",
    "editor-state",
    "config/catalogue/editor.json",
    "config/catalogue/settings.json",
    "setup.lock"
  ],
