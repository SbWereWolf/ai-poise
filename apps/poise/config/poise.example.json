{
  "schema": "stride-poise-config/v1",
  "installation_id": "example-poise",
  "session_store": "../state/sessions.sqlite",
  "caller": {
    "mode": "native"
  },
  "roles": [
    "author",
    "reviewer"
  ],
  "limits": {
    "packet_bytes": 65536,
    "sqlite_timeout_seconds": 0
  },
  "hooks": {
    "id": "example-hooks",
    "events": [
      "SessionStart",
      "UserPromptSubmit",
      "Stop",
      "SessionEnd"
    ],
    "context_template": "Session {session_id}; workspace {workspace}",
    "stop_template": "Session {session_id}; workspace {workspace}",
    "generic_config": null,
    "external": null,
    "probes": []
  }
}
