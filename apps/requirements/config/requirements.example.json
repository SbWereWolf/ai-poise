{
  "schema": "stride-requirements-config/v1",
  "paths": {
    "state": "../state",
    "database": "requirements.sqlite",
    "lock": "requirements.lock"
  },
  "batch": {
    "max_input_bytes": 8192,
    "max_items": 64
  },
  "lock": {
    "seconds": 1.0,
    "poll_seconds": 0.01
  },
  "task_ids": {
    "namespace": {
      "minimum": 1,
      "maximum": 999999
    },
    "width": 6,
    "progression": {
      "first": 1,
      "step": 1
    }
  }
}
