{
  "schema": "hook-settings-1",
  "root": "@ROOT@",
  "project_config": "@PROFILE@",
  "python": "@PYTHON@",
  "source_root": "@SOURCE@",
  "hooks_file": ".codex/architecture-hooks.json",
  "definitions": "architecture-definitions",
  "state": "architecture-hook-control",
  "lock": "architecture-hook-control.lock",
  "database": "hook-state.sqlite",
  "bindings": "bindings",
  "launcher": "work.sh",
  "binding_file": "binding.json",
  "observations": "observations",
  "response_file": "response.json",
  "cwd_roots": [
    "@CHECKOUT@"
  ],
  "file_mode": 384,
  "executable_mode": 448,
  "lock_seconds": 3,
  "lock_poll_seconds": 0.01,
  "max_input_bytes": 1048576,
  "output_chars": 5000,
  "max_probes": 30,
  "capability_summary": {
    "file": "capabilities.json",
    "header_template": "Infrastructure ready={ready}; checked_at={checked_at}; workspace={workspace}; snapshot={snapshot_path}",
    "item_template": "{id}: {status}; required={required}; reason={reason}; remediation={remediation}"
  },
  "probe_files": {
    "stdout": "stdout.txt",
    "stderr": "stderr.txt",
    "receipt": "receipt.json"
  },
  "exit_codes": {
    "success": 0,
    "incomplete": 1,
    "rejected": 2
  }
}
