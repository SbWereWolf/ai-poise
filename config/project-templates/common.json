{
  "schema": "project-blueprint-1",
  "version": "10",
  "config": {
    "accounting": {
      "causes": [
        "initial",
        "internal_qa",
        "delivered_rework",
        "requirement_change",
        "poise_incident"
      ],
      "max_blob_bytes": 1048576,
      "max_events": 1000,
      "max_files": 1000,
      "path_categories": {
        "code": [
          "src/**"
        ],
        "documentation": [
          "docs/**",
          "*.md"
        ],
        "fixtures": [
          "fixtures/**"
        ],
        "tests": [
          "tests/**"
        ]
      },
      "sources": {
        "codex": "observed",
        "test": "reported"
      },
      "storage": {
        "database": "telemetry/events.sqlite",
        "lock": "telemetry/events.lock"
      },
      "time_mode": "tool_cycle",
      "timezone": "UTC",
      "tokenizer": {
        "command": null,
        "identity": "not-configured",
        "kind": "unavailable"
      },
      "week_start": 0
    },
    "automatic_checks": [],
    "batch": {
      "artifact_directories": {
        "runtime": "generated",
        "sprint": "artifacts",
        "task": "artifacts"
      },
      "file_mode": 384,
      "initial_read_lines": 50,
      "max_artifact_bytes": 262144,
      "max_input_bytes": 1048576,
      "max_items": 1000,
      "message_reasons": [
        "initial",
        "continue",
        "feedback",
        "requirement_change",
        "clarification",
        "authorization",
        "cancel"
      ],
      "message_source": {
        "id": "codex-hook-main",
        "mode": "runtime_event"
      },
      "templates": {
        "note": {
          "parameters": [
            "title",
            "body"
          ],
          "text": "# ${title}\n\n${body}\n",
          "version": "1"
        }
      }
    },
    "environment_names": [
      "PATH",
      "HOME"
    ],
    "git": {
      "author_email": "${COMMIT_AUTHOR_EMAIL}",
      "author_name": "${COMMIT_AUTHOR_NAME}",
      "base_ref": "master",
      "branch_template": "tasks/{task_id}",
      "commit_pattern": "(?s).+",
      "push_required": false,
      "remote": "origin",
      "repository": "${REPOSITORY_ROOT}"
    },
    "limits": {
      "git_seconds": 15.0,
      "lock_poll_seconds": 0.01,
      "lock_seconds": 2.0,
      "sqlite_read_seconds": 2.0,
      "output_chars": 2200,
      "preview_chars": 300,
      "verify_attempts": 5
    },
    "paths": {
      "database": "tasks/tasks.sqlite",
      "git_index": "snapshot.index",
      "lock": "tasks/tasks.lock",
      "requirements_database": "${PROJECT_DATA_ROOT}/requirements/requirements.sqlite",
      "requirements_lock": "${PROJECT_DATA_ROOT}/requirements/requirements.lock",
      "requirements_schema_migrations": "${POISE_ROOT}/config/migrations/requirements",
      "requirements_data_migrations": "${PROJECT_ROOT}/docs/requirements/data",
      "requirements_schema_file": "${PROJECT_ROOT}/docs/requirements/schema.sql",
      "response": "response.json",
      "runs": "runs",
      "runtime": ".runtime",
      "sprints": "sprint",
      "standalone_tasks": "standalone",
      "state": "${PROJECT_DATA_ROOT}",
      "stderr": "stderr.txt",
      "stdout": "stdout.txt",
      "worktrees": "worktrees"
    },
    "project": "${PROJECT_ID}",
    "runtime_services": {
      "check_runner": {
        "diagnostic_override_max_seconds": 900,
        "history_multiplier": 1.1,
        "initial_seconds": 120,
        "poll_seconds": 0.1,
        "progress_gap_seconds": 120
      },
      "output": {
        "chunk_bytes": 65536,
        "directory": "views",
        "file_mode": 384,
        "job": "job.json",
        "known": [
          {
            "argv_tokens": [
              "-m",
              "unittest"
            ],
            "extended_bytes": 4096,
            "files": {
              "extended": "extended.txt",
              "full": "full.txt",
              "selected": "selected.txt"
            },
            "id": "unittest",
            "parser": "lines",
            "primary_chars": 512,
            "selected_bytes": 4096,
            "selection_pattern": "^(Ran [0-9]+ test|OK|FAILED|FAIL:|ERROR:).*"
          }
        ],
        "manifest": "views.json",
        "unknown": {
          "argv_tokens": [],
          "extended_bytes": 4096,
          "files": {
            "extended": "extended.txt",
            "full": "full.txt",
            "selected": null
          },
          "id": "unknown",
          "parser": "tail",
          "primary_chars": 512,
          "selected_bytes": 4096,
          "selection_pattern": null
        },
        "worker_stderr": "worker-err.txt",
        "worker_stdout": "worker-out.txt",
        "worker_timeout_seconds": 15
      }
    },
    "schema": "ddd-accounting-12",
    "sprint": {
      "acceptable_terminal_states": [
        "completed",
        "cancelled"
      ],
      "max_dependencies": 3000,
      "max_tasks": 1000,
      "section_rules": [
        {
          "name": "plan",
          "normalization": "strip",
          "required": true,
          "template": "Заполнить план."
        }
      ],
      "templates": {
        "basic": {
          "definition_of_done": [],
          "dependencies": [],
          "goal": "",
          "requirements": [],
          "sections": {
            "plan": "Заполнить план."
          },
          "tasks": [],
          "version": "1"
        }
      }
    },
    "task_decomposition": {
      "areas": [
        {
          "path": "src/**",
          "responsibility": "ai-poise"
        },
        {
          "path": "tests/**",
          "responsibility": "ai-poise"
        },
        {
          "path": "config/**",
          "responsibility": "project-configuration"
        },
        {
          "path": "docs/**",
          "responsibility": "documentation"
        },
        {
          "path": ".agents/**",
          "responsibility": "agent-instructions"
        },
        {
          "path": "AGENTS.md",
          "responsibility": "agent-instructions"
        },
        {
          "path": ".gitignore",
          "responsibility": "ai-poise"
        },
        {
          "path": "README.md",
          "responsibility": "ai-poise"
        },
        {
          "path": "fixtures/**",
          "responsibility": "ai-poise"
        },
        {
          "path": "pyproject.toml",
          "responsibility": "ai-poise"
        },
        {
          "path": "requirements*.txt",
          "responsibility": "ai-poise"
        },
        {
          "path": "stride.sh",
          "responsibility": "ai-poise"
        },
        {
          "path": "uv.lock",
          "responsibility": "ai-poise"
        },
        {
          "path": "bootstrap",
          "responsibility": "ai-poise"
        },
        {
          "path": "apps/bootstrap/**",
          "responsibility": "ai-poise"
        }
      ],
      "skills": [
        {
          "class": "meta",
          "id": "poise-workflow",
          "responsibility": null
        },
        {
          "class": "general",
          "id": "poise-development",
          "responsibility": null
        },
        {
          "class": "general",
          "id": "ast-index",
          "responsibility": null
        },
        {
          "class": "narrow",
          "id": "task-domain",
          "responsibility": "tasks"
        },
        {
          "class": "narrow",
          "id": "sprint-domain",
          "responsibility": "sprints"
        },
        {
          "class": "narrow",
          "id": "verification-domain",
          "responsibility": "verification"
        },
        {
          "class": "narrow",
          "id": "project-configuration",
          "responsibility": "project-configuration"
        }
      ]
    },
    "task_ids": {
      "namespace": {
        "maximum": 9999,
        "minimum": 1
      },
      "progression": {
        "first": 1,
        "step": 1
      },
      "width": 4
    },
    "task_planning": {
      "catalogue": "${POISE_SOURCE_ROOT}/config/catalogue/settings.json",
      "restart_revision_policy": {
        "reviewer": [
          "goal",
          "requirements",
          "requirements_snapshot",
          "requirements_agreement",
          "stage_contracts",
          "workflow"
        ],
        "user": [
          "goal",
          "goal_type",
          "requirements",
          "requirements_snapshot",
          "requirements_agreement",
          "definition_of_done",
          "methods",
          "method_inputs",
          "checks",
          "artifact_requirements",
          "content_contract",
          "evidence_plan",
          "executable_obligations",
          "stage_contracts",
          "decomposition",
          "workflow",
          "planning"
        ]
      }
    },
    "runtime_resources": {
      "project_setup": "${POISE_SOURCE_ROOT}/config/project-setup.json",
      "hooks": [
        {
          "installation_id": "poise-main",
          "settings_path": "${PROJECT_CONFIG_ROOT}/hooks-data-settings.json"
        }
      ]
    },
    "workflows": {
      "analysis": "${PROJECT_DATA_ROOT}/workflows/analysis.json",
      "design": "${PROJECT_DATA_ROOT}/workflows/design.json",
      "development": "${PROJECT_DATA_ROOT}/workflows/development.json",
      "documentation": "${PROJECT_DATA_ROOT}/workflows/documentation.json",
      "environment_diagnostics": "${PROJECT_DATA_ROOT}/workflows/environment_diagnostics.json",
      "environment_remediation": "${PROJECT_DATA_ROOT}/workflows/environment_remediation.json",
      "integration": "${PROJECT_DATA_ROOT}/workflows/integration.json",
      "profiling": "${PROJECT_DATA_ROOT}/workflows/profiling.json",
      "review": "${PROJECT_DATA_ROOT}/workflows/review.json",
      "sprint_planning": "${PROJECT_DATA_ROOT}/workflows/sprint_planning.json",
      "task_planning": "${PROJECT_DATA_ROOT}/workflows/task_planning.json",
      "test_development": "${PROJECT_DATA_ROOT}/workflows/test_development.json",
      "verification": "${PROJECT_DATA_ROOT}/workflows/verification.json"
    }
  },
  "questions": [
    {
      "id": "project",
      "path": [
        "project"
      ],
      "type": "text",
      "prompt": "Project identifier"
    },
    {
      "id": "repository",
      "path": [
        "git",
        "repository"
      ],
      "type": "text",
      "prompt": "Absolute Git repository root"
    },
    {
      "id": "base",
      "path": [
        "git",
        "base_ref"
      ],
      "type": "text",
      "prompt": "Exact base ref to resolve locally"
    },
    {
      "id": "remote",
      "path": [
        "git",
        "remote"
      ],
      "type": "text",
      "prompt": "Git remote name (still explicit when push is disabled)"
    },
    {
      "id": "author_name",
      "path": [
        "git",
        "author_name"
      ],
      "type": "text",
      "prompt": "Commit author name"
    },
    {
      "id": "author_email",
      "path": [
        "git",
        "author_email"
      ],
      "type": "text",
      "prompt": "Commit author email"
    },
    {
      "id": "push",
      "path": [
        "git",
        "push_required"
      ],
      "type": "boolean",
      "prompt": "Require push of verified task branch"
    },
    {
      "id": "state",
      "path": [
        "paths",
        "state"
      ],
      "type": "text",
      "prompt": "Explicit project data root (the project directory, without an extra state layer)"
    },
    {
      "id": "environment",
      "path": [
        "environment_names"
      ],
      "type": "strings",
      "prompt": "Names of inherited environment variables"
    },
    {
      "id": "worktrees",
      "path": [
        "paths",
        "worktrees"
      ],
      "type": "text",
      "prompt": "Explicit Task worktree path, relative to project data root or absolute"
    },
    {
      "id": "path_paths_requirements_database",
      "path": [
        "paths",
        "requirements_database"
      ],
      "type": "text",
      "prompt": "Explicit value for paths.requirements_database; replace root markers before publication"
    },
    {
      "id": "path_paths_requirements_lock",
      "path": [
        "paths",
        "requirements_lock"
      ],
      "type": "text",
      "prompt": "Explicit value for paths.requirements_lock; replace root markers before publication"
    },
    {
      "id": "path_paths_requirements_schema_migrations",
      "path": ["paths", "requirements_schema_migrations"],
      "type": "text",
      "prompt": "Explicit application-owned requirements schema migration directory"
    },
    {
      "id": "path_paths_requirements_data_migrations",
      "path": ["paths", "requirements_data_migrations"],
      "type": "text",
      "prompt": "Explicit project documentation directory for requirements DML migrations"
    },
    {
      "id": "path_paths_requirements_schema_file",
      "path": ["paths", "requirements_schema_file"],
      "type": "text",
      "prompt": "Explicit single current requirements schema SQL file in project documentation"
    },
    {
      "id": "path_task_planning_catalogue",
      "path": [
        "task_planning",
        "catalogue"
      ],
      "type": "text",
      "prompt": "Explicit value for task_planning.catalogue; replace root markers before publication"
    },
    {
      "id": "path_runtime_resources_project_setup",
      "path": [
        "runtime_resources",
        "project_setup"
      ],
      "type": "text",
      "prompt": "Explicit value for runtime_resources.project_setup; replace root markers before publication"
    },
    {
      "id": "path_workflows_analysis",
      "path": [
        "workflows",
        "analysis"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.analysis; replace root markers before publication"
    },
    {
      "id": "path_workflows_design",
      "path": [
        "workflows",
        "design"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.design; replace root markers before publication"
    },
    {
      "id": "path_workflows_development",
      "path": [
        "workflows",
        "development"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.development; replace root markers before publication"
    },
    {
      "id": "path_workflows_documentation",
      "path": [
        "workflows",
        "documentation"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.documentation; replace root markers before publication"
    },
    {
      "id": "path_workflows_environment_diagnostics",
      "path": [
        "workflows",
        "environment_diagnostics"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.environment_diagnostics; replace root markers before publication"
    },
    {
      "id": "path_workflows_environment_remediation",
      "path": [
        "workflows",
        "environment_remediation"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.environment_remediation; replace root markers before publication"
    },
    {
      "id": "path_workflows_integration",
      "path": [
        "workflows",
        "integration"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.integration; replace root markers before publication"
    },
    {
      "id": "path_workflows_profiling",
      "path": [
        "workflows",
        "profiling"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.profiling; replace root markers before publication"
    },
    {
      "id": "path_workflows_review",
      "path": [
        "workflows",
        "review"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.review; replace root markers before publication"
    },
    {
      "id": "path_workflows_sprint_planning",
      "path": [
        "workflows",
        "sprint_planning"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.sprint_planning; replace root markers before publication"
    },
    {
      "id": "path_workflows_task_planning",
      "path": [
        "workflows",
        "task_planning"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.task_planning; replace root markers before publication"
    },
    {
      "id": "path_workflows_test_development",
      "path": [
        "workflows",
        "test_development"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.test_development; replace root markers before publication"
    },
    {
      "id": "path_workflows_verification",
      "path": [
        "workflows",
        "verification"
      ],
      "type": "text",
      "prompt": "Explicit value for workflows.verification; replace root markers before publication"
    }
  ],
  "workflow_sources": {
    "analysis": {
      "path": "app/config/catalogue/workflows/analysis.json"
    },
    "design": {
      "path": "app/config/catalogue/workflows/design.json"
    },
    "development": {
      "path": "app/config/catalogue/workflows/development.json"
    },
    "documentation": {
      "path": "app/config/catalogue/workflows/documentation.json"
    },
    "environment_diagnostics": {
      "path": "app/config/catalogue/workflows/environment_diagnostics.json"
    },
    "environment_remediation": {
      "path": "app/config/catalogue/workflows/environment_remediation.json"
    },
    "integration": {
      "path": "app/config/catalogue/workflows/integration.json"
    },
    "profiling": {
      "path": "app/config/catalogue/workflows/profiling.json"
    },
    "review": {
      "path": "app/config/catalogue/workflows/review.json"
    },
    "sprint_planning": {
      "path": "app/config/catalogue/workflows/sprint_planning.json"
    },
    "task_planning": {
      "path": "app/config/catalogue/workflows/task_planning.json"
    },
    "test_development": {
      "path": "app/config/catalogue/workflows/test_development.json"
    },
    "verification": {
      "path": "app/config/catalogue/workflows/verification.json"
    }
  }
}
