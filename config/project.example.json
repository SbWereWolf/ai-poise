{
  "schema": "ddd-accounting-12",
  "project": "demo",
  "paths": {
    "state": "state",
    "database": "state.sqlite",
    "lock": "state.lock",
    "runtime": "runtime",
    "standalone_tasks": "standalone",
    "sprints": "sprints",
    "worktrees": "worktrees",
    "git_index": "snapshot.index",
    "runs": "runs",
    "stdout": "stdout.txt",
    "stderr": "stderr.txt",
    "response": "response.json"
  },
  "limits": {
    "lock_seconds": 2.0,
    "lock_poll_seconds": 0.01,
    "git_seconds": 15.0,
    "verify_attempts": 5,
    "output_chars": 2200,
    "preview_chars": 300
  },
  "git": {
    "repository": "REPLACE_WITH_ABSOLUTE_APPLICATION_REPOSITORY",
    "base_ref": "main",
    "remote": "REPLACE_WITH_CONFIGURED_REMOTE_NAME",
    "branch_template": "tasks/{task_id}",
    "commit_pattern": ".+",
    "author_name": "REPLACE_WITH_COMMIT_AUTHOR_NAME",
    "author_email": "REPLACE_WITH_COMMIT_AUTHOR_EMAIL",
    "push_required": true
  },
  "processes": {
    "development": "config/processes/development.json",
    "documentation": "config/processes/documentation.json"
  },
  "environment_names": [
    "PATH",
    "HOME"
  ],
  "automatic_checks": [
    {
      "paths": [
        "src/**",
        "tests/**"
      ],
      "by_stage": {
        "tests": [
          "RED"
        ],
        "test_review": [],
        "test_fix": [
          "RED"
        ],
        "test_recheck": [],
        "implementation": [
          "GREEN"
        ],
        "code_review": [],
        "code_fix": [
          "GREEN"
        ],
        "code_recheck": [],
        "draft": [],
        "editorial": [],
        "amend": [],
        "editorial_followup": []
      }
    }
  ],
  "batch": {
    "max_input_bytes": 1048576,
    "max_items": 1000,
    "max_artifact_bytes": 262144,
    "file_mode": 384,
    "artifact_lock": "artifact.lock",
    "artifact_directories": {
      "runtime": "generated",
      "task": "artifacts",
      "sprint": "artifacts"
    },
    "templates": {
      "note": {
        "version": "1",
        "text": "# ${title}\n\n${body}\n",
        "parameters": [
          "title",
          "body"
        ]
      }
    },
    "message_source": {
      "id": "chat-visible",
      "mode": "agent_reported"
    },
    "message_reasons": [
      "initial",
      "continue",
      "feedback",
      "requirement_change",
      "clarification",
      "authorization",
      "cancel"
    ],
    "initial_read_lines": 50
  },
  "sprint": {
    "max_tasks": 1000,
    "max_dependencies": 3000,
    "acceptable_terminal_states": [
      "completed",
      "cancelled"
    ],
    "templates": {
      "basic": {
        "version": "1",
        "goal": "",
        "requirements": [],
        "definition_of_done": [],
        "sections": {
          "plan": "Заполнить план."
        },
        "tasks": [],
        "dependencies": []
      }
    },
    "section_rules": [
      {
        "name": "plan",
        "template": "Заполнить план.",
        "normalization": "strip",
        "required": true
      }
    ]
  },
  "runtime_services": {
    "output": {
      "known": [
        {
          "id": "unittest",
          "argv_tokens": [
            "-m",
            "unittest"
          ],
          "parser": "lines",
          "selection_pattern": "^(Ran [0-9]+ test|OK|FAILED|FAIL:|ERROR:).*",
          "primary_chars": 512,
          "extended_bytes": 4096,
          "selected_bytes": 4096,
          "files": {
            "extended": "extended.txt",
            "full": "full.txt",
            "selected": "selected.txt"
          }
        }
      ],
      "unknown": {
        "id": "unknown",
        "argv_tokens": [],
        "parser": "tail",
        "selection_pattern": null,
        "primary_chars": 512,
        "extended_bytes": 4096,
        "selected_bytes": 4096,
        "files": {
          "extended": "extended.txt",
          "full": "full.txt",
          "selected": null
        }
      },
      "directory": "views",
      "manifest": "views.json",
      "job": "job.json",
      "worker_stdout": "worker-out.txt",
      "worker_stderr": "worker-err.txt",
      "chunk_bytes": 65536,
      "worker_timeout_seconds": 15,
      "file_mode": 384
    },
    "handoff": {
      "directory": "handoffs",
      "receipt": "handoff.json",
      "bundle": "source.bundle",
      "preserved_directory": "preserved",
      "file_mode": 384
    },
    "transfer": {
      "directory": "transfers",
      "archive": "work.zip",
      "manifest": "manifest.json",
      "database": "snapshot.sqlite",
      "files_directory": "files",
      "bundles_directory": "bundles",
      "max_tasks": 1000,
      "max_files": 10000,
      "max_file_bytes": 33554432,
      "max_total_bytes": 134217728,
      "chunk_bytes": 65536,
      "file_mode": 384
    }
  },
  "accounting": {
    "timezone": "UTC",
    "week_start": 0,
    "storage": {
      "database": "telemetry/events.sqlite",
      "lock": "telemetry/events.lock"
    },
    "max_events": 1000,
    "max_files": 1000,
    "max_blob_bytes": 1048576,
    "time_mode": "tool_cycle",
    "causes": [
      "initial",
      "internal_qa",
      "delivered_rework",
      "requirement_change",
      "poise_incident"
    ],
    "sources": {
      "test": "reported",
      "codex": "observed"
    },
    "path_categories": {
      "code": [
        "src/**"
      ],
      "tests": [
        "tests/**"
      ],
      "fixtures": [
        "fixtures/**"
      ],
      "documentation": [
        "docs/**",
        "*.md"
      ]
    },
    "tokenizer": {
      "kind": "unavailable",
      "identity": "not-configured",
      "command": null
    }
  }
}
