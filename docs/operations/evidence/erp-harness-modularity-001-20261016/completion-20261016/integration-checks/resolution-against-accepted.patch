+    def assert_catalogue_loading_boundary(self, case: dict, boundary: str) -> None:
+        catalogue = self.diagnostic_catalogue()
+        profile = catalogue / "ai-assistant/checks/command-profiles.toml"
+        self.hook_subject = self.env.subject
+        self.hook_config = catalogue
+        if boundary == "cli":
+            expected_type = {
+                "FileNotFoundError": FileNotFoundError,
+                "PermissionError": PermissionError,
+                "TOMLDecodeError": tomllib.TOMLDecodeError,
+                "UnicodeDecodeError": UnicodeDecodeError,
+                "ProfileError": binding.ProfileError,
+            }[case["exception"]]
+            with self.catalogue_loading_fault(case, catalogue) as injected:
+                with patch.object(registered_service, "run_registered_command", wraps=registered_service.run_registered_command) as runner:
+                    with self.assertRaises(expected_type) as caught:
+                        self.env.invoke_argv([
+                            "--command-id", "provider-binding-contract", "--runtime-class", "posix-host",
+                            "--project-root", str(self.env.subject), "--config-root", str(catalogue), "--json",
+                        ])
+                    self.assertEqual(runner.call_count, 0)
+                error = caught.exception
+                self.assertIs(type(error), expected_type)
+                self.assertIsNone(error.__cause__)
+                if injected is not None:
+                    self.assertIs(error, injected)
+                if case["id"] in {"missing", "unreadable"}:
+                    self.assertEqual(error.filename, str(profile))
+                    self.assertEqual(error.errno, case["errno"])
+                if case["id"] == "invalid_utf8":
+                    self.assertEqual(error.encoding, "utf-8")
+                    self.assertEqual(error.object, bytes.fromhex(case["payload_hex"]))
+                    self.assertEqual((error.start, error.end), (0, 1))
+                message = str(error)
+                if hasattr(error, "__notes__"):
+                    message += "\n" + "\n".join(error.__notes__)
+                self.assert_loading_no_effects()
+                self.assert_loading_diagnostic(message, case, catalogue)
+        elif boundary in {"direct_admission", "mcp_admission"}:
+            with self.catalogue_loading_fault(case, catalogue):
+                if boundary == "direct_admission":
+                    command = self.env.command() + " --config-root " + shlex.quote(str(catalogue))
+                    code, output, error = self.raw_hook("Bash", {"command": command})
+                    self.assertEqual(code, 0, error)
+                else:
+                    code, output, error = self.raw_hook("mcp__repo_checks__run", self.public_arguments())
+                    self.assertEqual(code, case["mcp_admission_exit"], error)
+                if code == 0:
+                    specific = json.loads(output)["hookSpecificOutput"]
+                    self.assertEqual(specific["permissionDecision"], "deny")
+                    message = specific["permissionDecisionReason"]
+                else:
+                    self.assertEqual(output, "")
+                    self.assertIn("Registered-command hook failed closed", error)
+                    message = error
+                self.assert_loading_no_effects()
+                self.assert_loading_diagnostic(message, case, catalogue)
+        elif boundary == "mcp_execution":
+            decision = self.admit_mcp(self.public_arguments())
+            expected = self.expected_mcp_row()
+            self.assertEqual(self.own_active_rows(), [expected])
+            with self.server_transport(self.env.subject, config_root=catalogue) as (server, responses):
+                with self.catalogue_loading_fault(case, catalogue):
+                    with patch.object(registered_service, "run_registered_command", wraps=registered_service.run_registered_command) as runner:
+                        self.call(server, decision["updatedInput"])
+                        self.assertEqual(runner.call_count, 0)
+                    self.assert_loading_no_effects(expected)
+                    response = self.response_for(responses, 2)
+                    kind = case["mcp_run_transport"]
+                    if kind == "tool_error":
+                        self.assertNotIn("error", response)
+                        result = response["result"]
+                        self.assertTrue(result["isError"])
+                        self.assertNotIn("structuredContent", result)
+                        self.assertEqual(len(result["content"]), 1)
+                        self.assertEqual(result["content"][0]["type"], "text")
+                        message = result["content"][0]["text"]
+                    else:
+                        self.assertNotIn("result", response)
+                        expected_code = {"invalid_profile": -32602, "internal_error": -32603}[kind]
+                        self.assertEqual(response["error"]["code"], expected_code)
+                        message = response["error"]["message"]
+                    self.assert_loading_diagnostic(message, case, catalogue)
+        else:
+            raise AssertionError("Unknown catalogue-loading fixture boundary")
