+        self.assertIn("catalogue=" + str(catalogue / "ai-assistant/checks/command-profiles.toml"), message)
+        self.assertIn(case["recovery"], message)
+        if case["id"] != "unreadable":
+            self.assertIn("UTF-8 TOML", message)
+            self.assertIn("schema_version=1", message)
+
