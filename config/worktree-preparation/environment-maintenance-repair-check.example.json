{
  "requirements": [
    {
      "id": "application-runtime",
      "commands": [
        {
          "argv": [
            "${repository}/.venv/bin/python",
            "-I",
            "-B",
            "-c",
            "import environment_maintenance, jsonpatch, jsonpointer"
          ],
          "cwd": "${repository}",
          "env": {
            "PATH": "${path}",
            "PYTHONPATH": "${module_path}",
            "LANG": "C.UTF-8"
          },
          "interpreter": {
            "name": "exit",
            "options": {
              "accept": [
                0
              ]
            }
          }
        },
        {
          "argv": [
            "${repository}/start-app",
            "--help"
          ],
          "cwd": "${repository}",
          "env": {
            "PATH": "${path}",
            "PYTHONPATH": "${module_path}",
            "LANG": "C.UTF-8"
          },
          "interpreter": {
            "name": "exit",
            "options": {
              "accept": [
                0
              ]
            }
          }
        }
      ]
    }
  ]
}
