+    def arranged_request(self, scope: str | None, tool: str | None):
+        # Only the request-state boundary is arranged here; real handle/cancel
+        # and ActiveRequest ownership run. No process-termination claim.
+        state = self.server_module.ActiveRequest(threading.Event(), scope, tool)
+        state.finished.set()
+        return state
