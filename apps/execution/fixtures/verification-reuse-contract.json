  "program_lines": [
    "from pathlib import Path",
    "import os",
    "import sys",
    "import time",
    "",
    "mode = Path(\"outputs/verification-mode.txt\").read_text().strip()",
    "control = Path(os.environ[\"VERIFY_CONTROL\"])",
    "if (control / \"hold\").exists():",
    "    (control / \"ready\").write_text(\"ready\\n\")",
    "    while not (control / \"release\").exists():",
    "        time.sleep(0.01)",
    "with Path(os.environ[\"VERIFY_COUNTER\"]).open(\"a\") as stream:",
    "    stream.write(str(Path.cwd()) + \"|\" + os.environ[\"VERIFY_METHOD\"] + \"|\" + mode + \"\\n\")",
    "output = Path(os.environ[\"POISE_RUN_OUTPUT_DIR\"])",
    "output.mkdir(parents=True, exist_ok=True)",
    "if mode != \"missing\":",
    "    (output / \"report.txt\").write_bytes(b\"Verified result.\\n\")",
    "    (output / \"payload.bin\").write_bytes(b\"\\x00\\xffresult\\x80\\n\")",
    "if mode == \"bad\":",
    "    sys.stdout.buffer.write(b\"CHECKED:BAD\\n\")",
    "    sys.stderr.buffer.write(b\"verified\\n\")",
    "    raise SystemExit(7)",
    "if mode == \"raw\":",
    "    sys.stdout.buffer.write(b\"CHECKED:OK\\n\\x00\\xff\")",
    "    sys.stderr.buffer.write(b\"verified\\n\\xfe\")",
    "else:",
    "    sys.stdout.buffer.write(b\"CHECKED:OK\\n\")",
    "    sys.stderr.buffer.write(b\"verified\\n\")"
  ],
