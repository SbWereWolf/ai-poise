+    @contextlib.contextmanager
+    def request_states(self, server, own_tool="provider-binding-tool"):
+        own = self.arranged_request("provider-binding-session", own_tool)
+        foreign = self.arranged_request("foreign-active-scope", "foreign-active-tool")
+        server.active[40] = own
+        server.active[41] = foreign
+        try:
+            yield own, foreign
+        finally:
+            server.active.clear()
