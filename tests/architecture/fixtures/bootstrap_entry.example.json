{
  "parameters": {
    "python": "TEST_PYTHON",
    "probe": "TEST_PROBE",
    "marker": "TEST_MARKER",
    "log": "TEST_LOG",
    "scenario": "ready"
  },
  "commands": {
    "infra": ["${python}", "-I", "-B", "${probe}", "infra", "CONTEXT", "${marker}", "${log}", "${scenario}"],
    "deps": ["${python}", "-I", "-B", "${probe}", "deps", "CONTEXT", "${marker}", "${log}", "${scenario}"],
    "check": ["${python}", "-I", "-B", "${probe}", "check", "CONTEXT", "${marker}", "${log}", "${scenario}"],
    "run": ["${python}", "-I", "-B", "${probe}", "run", "CONTEXT", "${marker}", "${log}", "${scenario}"]
  },
  "handler": {
    "callable": "fixture_handlers:second",
    "options": {"marker": "selected-handler"}
  }
}
