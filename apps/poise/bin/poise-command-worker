#!/usr/bin/env python3
"""Private app-local entry; only one durable claim may execute a command."""
from pathlib import Path
import sys

sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
from infrastructure.command_store import CommandStore
from infrastructure.command_execution import execute_owned

if len(sys.argv)!=5:
    raise SystemExit(2)
store,timeout,session,id=sys.argv[1:]
execute_owned(CommandStore(store,float(timeout)),session,id)
