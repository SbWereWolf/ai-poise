{
  "check_runner": {
    "initial_seconds": 120,
    "history_multiplier": 1.1,
    "progress_gap_seconds": 120,
    "poll_seconds": 0.1,
    "diagnostic_override_max_seconds": 900
  },
  "output": {
    "known": [
      {
        "id": "unittest",
        "argv_tokens": [
          "-m",
          "unittest"
        ],
        "parser": "lines",
        "selection_pattern": "^(Ran [0-9]+ test|OK|FAILED|FAIL:|ERROR:).*",
        "primary_chars": 512,
        "extended_bytes": 4096,
        "selected_bytes": 4096,
        "files": {
          "extended": "extended.txt",
          "full": "full.txt",
          "selected": "selected.txt"
        }
      }
    ],
    "unknown": {
      "id": "unknown",
      "argv_tokens": [],
      "parser": "tail",
      "selection_pattern": null,
      "primary_chars": 512,
      "extended_bytes": 4096,
      "selected_bytes": 4096,
      "files": {
        "extended": "extended.txt",
        "full": "full.txt",
        "selected": null
      }
    },
    "directory": "views",
    "manifest": "views.json",
    "job": "job.json",
    "worker_stdout": "worker-out.txt",
    "worker_stderr": "worker-err.txt",
    "chunk_bytes": 65536,
    "worker_timeout_seconds": 15,
    "file_mode": 384
  },
  "handoff": {
    "directory": "handoffs",
    "receipt": "handoff.json",
    "bundle": "source.bundle",
    "preserved_directory": "preserved",
    "file_mode": 384
  },
  "transfer": {
    "directory": "transfers",
    "archive": "work.zip",
    "manifest": "manifest.json",
    "database": "snapshot.sqlite",
    "files_directory": "files",
    "bundles_directory": "bundles",
    "max_tasks": 1000,
    "max_files": 10000,
    "max_file_bytes": 33554432,
    "max_total_bytes": 134217728,
    "chunk_bytes": 65536,
    "file_mode": 384
  }
}
