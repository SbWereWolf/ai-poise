{
  "schema": "stride-orchestrator-config/v1",
  "paths": {
    "state": "../state",
    "database": "orchestrator.sqlite",
    "lock": "orchestrator.lock"
  },
  "batch": {
    "max_input_bytes": 65536,
    "max_items": 128
  },
  "read": {
    "max_queries": 128
  },
  "lock": {
    "seconds": 5.0,
    "poll_seconds": 0.05
  },
  "commands": {
    "requirements": {
      "protocol": "owner-json-v1",
      "argv": [
        "/absolute/path/python3.13",
        "/absolute/path/ai-poise/apps/requirements/bin/requirements",
        "--config",
        "/absolute/path/config/requirements.json"
      ],
      "cwd": "/absolute/path/ai-poise",
      "env": {
        "PATH": "/absolute/path/python-bin:/usr/bin:/bin"
      },
      "timeout_seconds": 10.0,
      "accepted_exit_codes": [
        0,
        2
      ]
    },
    "sequencing": {
      "protocol": "owner-json-v1",
      "argv": [
        "/absolute/path/python3.13",
        "/absolute/path/ai-poise/apps/sequencing/bin/sequencing",
        "--config",
        "/absolute/path/config/sequencing.json"
      ],
      "cwd": "/absolute/path/ai-poise",
      "env": {
        "PATH": "/absolute/path/python-bin:/usr/bin:/bin"
      },
      "timeout_seconds": 10.0,
      "accepted_exit_codes": [
        0,
        2
      ]
    },
    "execution": {
      "protocol": "owner-json-v1",
      "argv": [
        "/absolute/path/python3.13",
        "/absolute/path/ai-poise/apps/execution/bin/execution",
        "--config",
        "/absolute/path/config/execution.json"
      ],
      "cwd": "/absolute/path/ai-poise",
      "env": {
        "PATH": "/absolute/path/python-bin:/usr/bin:/bin"
      },
      "timeout_seconds": 10.0,
      "accepted_exit_codes": [
        0,
        2
      ]
    }
  }
}
