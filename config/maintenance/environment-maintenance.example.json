          "-m",
          "poise_environment.repairs.python_runtime",
          "--minimum",
          "${python_minimum}",
          "--maximum",
          "${python_maximum}",
          "--requirement-id",
          "python-runtime",
          "--action",
          "check",
          "--schema",
          "poise/maintenance-action/v2",
          "--recommendations",
          "${profile_root}/recommendations.json"
        ],
        "cwd": "${profile_root}",
        "env": {
          "PYTHONPATH": "${module_path}",
          "PYTHONDONTWRITEBYTECODE": "1",
          "LANG": "C.UTF-8"
        },
        "output": {
          "schema": "poise/maintenance-action/v2"
        },
        "max_output_bytes": 65536,
        "execution_bound_seconds": 60
      },
