@@ -0,0 +1,2091 @@
+"""Admission regressions using controlled data, not a live Git checkout.
+
+RCAL/RCMCP exercise real dispatcher/runner/MCP owners. External Git
+facts and stdin/stdout transport are unit seams; sources are exact copies.
+Foreign state is arranged and asserted through independent raw SQL.
+"""
+
+from __future__ import annotations
+
+import contextlib
+from datetime import datetime, timezone
+import gc
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+import shlex
+import shutil
+import sqlite3
+import subprocess
+import sys
+import tempfile
+import threading
+import tomllib
+import unittest
+from unittest.mock import patch
+
+
+ROOT = Path(__file__).resolve().parents[3]
+FIXTURES = Path(__file__).parent / "fixtures/registered-check-lock"
+
+
+def load_fixture_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+binding = load_fixture_module(
+    "registered_lock_binding_fixture",
+    ROOT / "ai-assistant/tests/checks/provider-binding.py",
+)
+import registered_check_service as registered_service
+from check_configuration import CheckConfiguration
+
+dispatcher = load_fixture_module(
+    "registered_lock_dispatcher",
+    ROOT / ".codex/hooks/tool-use-dispatcher.py",
+)
+
+
+class RegisteredCheckFixture(unittest.TestCase):
+    @contextlib.contextmanager
+    def database(self, path: Path):
+        with contextlib.closing(sqlite3.connect(path)) as connection:
+            with connection:
+                yield connection
+
+    def setUp(self) -> None:
+        self.temporary = tempfile.TemporaryDirectory(prefix="registered-check-lock-unit-")
+        self.addCleanup(self.temporary.cleanup)
+        base = Path(self.temporary.name)
+        primary = base / "primary"
+        hook_source = primary / ".codex/hooks/tool-use-dispatcher.py"
+        server_source = primary / "ai-assistant/mcp/repo-checks-server.py"
+        for source, target in (
+            (ROOT / ".codex/hooks/tool-use-dispatcher.py", hook_source),
+            (ROOT / "ai-assistant/mcp/repo-checks-server.py", server_source),
+        ):
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(source, target)
+            self.assertEqual(target.read_bytes(), source.read_bytes())
+        self.env = binding.UnitEnvironment(base)
+        self.dispatcher = load_fixture_module("registered_lock_hook_fixture", hook_source)
+        self.server_module = load_fixture_module("registered_lock_server_fixture", server_source)
+        self.hook_subject = self.env.primary
+        self.hook_config = self.env.primary
+        self.event_cwd = self.env.primary
+        self.started_at = datetime.now(timezone.utc).isoformat()
+        foreign = json.loads((FIXTURES / "foreign-state.json").read_text())
+        self.foreign_active = (*foreign["active"][:-1], self.started_at)
+        self.foreign_completed = (*foreign["completed"][:-1], self.started_at)
+        with self.database(self.env.registry.path) as connection:
+            connection.executescript((FIXTURES / "registry.sql").read_text())
+            connection.execute(
+                "INSERT INTO active_checks VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                self.foreign_active,
+            )
+            connection.execute(
+                "INSERT INTO completed_checks VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                self.foreign_completed,
+            )
+        self.assert_foreign_unchanged()
+
+    def assert_foreign_unchanged(self) -> None:
+        with self.database(self.env.registry.path) as connection:
+            active = connection.execute(
+                "SELECT * FROM active_checks WHERE scope_key <> ? ORDER BY scope_key",
+                ("provider-binding-session",),
+            ).fetchall()
+            completed = connection.execute(
+                "SELECT * FROM completed_checks WHERE scope_key <> ? ORDER BY scope_key",
+                ("provider-binding-session",),
+            ).fetchall()
+        self.assertEqual(active, [self.foreign_active])
+        self.assertEqual(completed, [self.foreign_completed])
+
+    def own_active_rows(self) -> list[tuple]:
+        with self.database(self.env.registry.path) as connection:
+            return connection.execute(
+                "SELECT * FROM active_checks WHERE scope_key = ?",
+                ("provider-binding-session",),
+            ).fetchall()
+
+    def expected_admission(self, command_id: str) -> tuple:
+        row = json.loads((FIXTURES / "admitted-row.json").read_text())
+        row[5] = command_id
+        row[8] = self.started_at
+        return tuple(row)
+
+    def own_completed_rows(self) -> list[tuple]:
+        with self.database(self.env.registry.path) as connection:
+            return connection.execute(
+                "SELECT * FROM completed_checks WHERE scope_key = ?",
+                ("provider-binding-session",),
+            ).fetchall()
+
+    def assert_own_terminal(self, expected_row: tuple) -> None:
+        self.assert_foreign_unchanged()
+        self.assertEqual(self.own_active_rows(), [])
+        self.assertEqual(self.own_completed_rows(), [expected_row])
+
+    @contextlib.contextmanager
+    def no_registry_mutations(self):
+        owner = type(self.env.registry)
+        with contextlib.ExitStack() as stack:
+            calls = {name: stack.enter_context(patch.object(owner, name, autospec=True, side_effect=getattr(owner, name)))
+                     for name in ("_connect", "_prune", "claim", "release", "complete")}
+            yield
+            for name, call in calls.items():
+                self.assertEqual(call.call_count, 0, f"dry-run called mutating registry owner {name}")
+
+    def raw_hook(
+        self, tool_name: str, tool_input: dict, *,
+        event_name: str = "PreToolUse", tool_id: str = "provider-binding-tool",
+        tool_response: dict | None = None,
+    ) -> tuple[int, str, str]:
+        event = json.loads((FIXTURES / "hook-event.json").read_text())
+        event["tool_name"] = tool_name
+        event["tool_input"] = tool_input
+        event["hook_event_name"] = event_name
+        event["tool_use_id"] = tool_id
+        event["cwd"] = str(self.event_cwd)
+        if tool_response is not None:
+            event["tool_response"] = tool_response
+        agent = ROOT / "ai-assistant/agent"
